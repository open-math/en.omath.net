m(count, \"Sponsor\", \"Sponsors\")",{"type":22,"value":38},"Light",{"type":22,"value":40},"Category",{"type":22,"value":42},"Search",{"type":22,"value":44},"Materials",{"type":22,"value":46},"Key elements",{"type":22,"value":48},"Statistics",{"type":22,"value":50},"Dark",{"type":22,"value":52},"Topic",{"type":22,"value":54},"Languages",{"type":22,"value":56},"System",{"type":22,"value":58},"Article",{"type":22,"value":60},"Settings",{"type":22,"value":62},"Built",{"type":22,"value":64},"Summary",{"type":22,"value":66},"Content",{"type":22,"value":68},"Practice",{"type":22,"value":70},"Erudit",{"type":22,"value":72},"You are about to open a content page:",{"type":22,"value":74},"Add translation",{"type":22,"value":76},"Main page",{"type":22,"value":78},"Contributors",{"type":22,"value":80},"Sponsors",{"type":22,"value":82},"Search the site...",{"type":22,"value":84},"Searching more...",{"type":22,"value":86},"No results found",{"type":22,"value":88},"No more results",{"type":22,"value":90},"No content.",{"type":22,"value":92},"To index",{"type":22,"value":94},"About textbook",{"type":22,"value":96},"Development",{"type":22,"value":98},"Advanced",{"type":22,"value":100},"Additional",{"type":22,"value":102},"List of people and organizations that support the project financially. Thanks to them, the project can exist and develop. If you want to help the project, you can become a sponsor and get on this page too!",{"type":22,"value":104},"List of people who contributed to the project materials: suggested valuable ideas, made corrections to existing material or wrote their own!",{"type":22,"value":106},"Become a sponsor",{"type":22,"value":108},"You can also help the project, make a contribution and get on this page!",{"type":22,"value":110},"There are no sponsors yet. You can be the first one!",{"type":22,"value":112},"Become a contributor",{"type":22,"value":114},"There are no contributors yet. You can be the first one!",{"type":22,"value":116},"Contribution",{"type":22,"value":118},"Editor",{"type":27,"value":120},"(name) => `Personal page of contributor \"${name}\" with information about their contributions to the project.`",{"type":22,"value":122},"Begin Learning!",{"type":22,"value":124},"Connections",{"type":22,"value":126},"Need to know",{"type":22,"value":128},"Depends on",{"type":22,"value":130},"Used by",{"type":22,"value":132},"Externals",{"type":27,"value":134},"(contentTitle) => `Clear and interesting explanation of the topic \"${contentTitle}\". Clear examples, important terms and statements, interesting facts, life applications.`",{"type":27,"value":136},"(contentTitle) => `Summary of the topic \"${contentTitle}\": key definitions, theorems, properties and examples of their use. All the most important things in a concise form!`",{"type":27,"value":138},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":22,"value":98},{"type":22,"value":141},"This material is for learners with a high level of knowledge. It contains information that is not suitable for beginners!",{"type":22,"value":96},{"type":22,"value":144},"This material is in development! It may change in the future and even contain errors!",{"type":22,"value":100},{"type":22,"value":147},"This is an optional material is for learners who want to dive deeper and gain additional knowledge and context.",{"m":149},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":151,"mainContent":152},"page/faq/",{"fullId":9,"shortId":9,"contentRelativePath":153,"title":10,"breadcrumbs":154,"description":155,"decoration":156,"stats":157,"contributions":160,"type":8,"proseElement":166,"storage":730,"snippets":789,"toc":826},"00-faq",[],"\n    Answers to frequently asked questions: what is this site? who is it for?\n    Recommendations for effectively using the site features to learn math.\n    If you just arrived at this site, start here.\n  ","content/00-faq/decoration.svg",{"elements":158},{"accent_important":159},2,[161],{"contributorId":162,"name":163,"avatarUrl":164,"description":165},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","Idea and main content.",{"__JSPROSE_element":167,"schemaName":168,"children":169},true,"mix",[170,176,183,189,222,227,315,319,329,341,355,359,364,370,398,402,415,421,426,431,449,460,511,601,606,623,632,636,646,650,662,671,675,692,703,707,718],{"__JSPROSE_element":167,"schemaName":171,"data":172,"id":175},"heading",{"level":173,"title":174},1,"What is this site?","what-is-this-site",{"__JSPROSE_element":167,"schemaName":177,"children":178,"id":182},"paragraph",[179],{"__JSPROSE_element":167,"schemaName":180,"data":181},"text","Everyone has internet access today. It contains a huge amount of scattered resources on math with fragmentary data. In some places, the theory is presented well; in others, there are only problems, and so on... And we are creating a single resource with the best materials for learning mathematics, without the need to look for theory or problems elsewhere.","paragraph-KZR0osnxpm1E",{"__JSPROSE_element":167,"schemaName":184,"data":185,"storageKey":186,"id":188},"image",{"src":186,"width":187},"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/concept.svg","800px","image-SpooV86nQ5Qv",{"__JSPROSE_element":167,"schemaName":190,"data":191,"children":194,"id":221,"uniqueName":221},"accent_important",{"title":192,"layout":193},"Goal of \"Open Math\"","column",[195],{"__JSPROSE_element":167,"schemaName":196,"children":197},"accentMain_important",[198],{"__JSPROSE_element":167,"schemaName":177,"children":199,"id":220},[200,202,210,212,218],{"__JSPROSE_element":167,"schemaName":180,"data":201},"To become the ideal and unified resource for ",{"__JSPROSE_element":167,"schemaName":203,"data":204,"children":206,"id":209},"emphasis",{"type":205,"accent":167},"bold",[207],{"__JSPROSE_element":167,"schemaName":180,"data":208},"self-study","emphasis-A9322hGJLt12",{"__JSPROSE_element":167,"schemaName":180,"data":211}," of mathematics. So that ",{"__JSPROSE_element":167,"schemaName":203,"data":213,"children":214,"id":217},{"type":205,"accent":167},[215],{"__JSPROSE_element":167,"schemaName":180,"data":216},"anyone","emphasis-znMy7lcbX9Jw",{"__JSPROSE_element":167,"schemaName":180,"data":219}," can understand the theory (in Articles), remember key points (in Summaries), and comprehensively practice applying the knowledge to problems (in Practicums).","paragraph-BJ2Vx5090ufM","goal",{"__JSPROSE_element":167,"schemaName":177,"children":223,"id":226},[224],{"__JSPROSE_element":167,"schemaName":180,"data":225},"Key project principles:","paragraph-VLTm5aH0yhay",{"__JSPROSE_element":167,"schemaName":228,"data":229,"children":231,"id":313,"uniqueName":314},"list",{"type":230},"ul",[232,265,289],{"__JSPROSE_element":167,"schemaName":233,"children":234},"listItem",[235,244],{"__JSPROSE_element":167,"schemaName":177,"children":236,"id":243},[237],{"__JSPROSE_element":167,"schemaName":203,"data":238,"children":239,"id":242},{"type":205},[240],{"__JSPROSE_element":167,"schemaName":180,"data":241},"This is not an ad.","emphasis-AtgZ0TViHcgS","paragraph-L7JkIe6HeK4y",{"__JSPROSE_element":167,"schemaName":177,"children":245,"id":264},[246,248,254,256,262],{"__JSPROSE_element":167,"schemaName":180,"data":247},"Many tutors, online schools, and universities create \"web textbooks\" specifically with free materials. The goal is to appear in search engines for math-related queries and advertise their services/courses/training. \"Open Math\" is ",{"__JSPROSE_element":167,"schemaName":203,"data":249,"children":250,"id":253},{"type":205},[251],{"__JSPROSE_element":167,"schemaName":180,"data":252},"NOT","emphasis-cqAUHoQWzbHV",{"__JSPROSE_element":167,"schemaName":180,"data":255}," and will never ",{"__JSPROSE_element":167,"schemaName":203,"data":257,"children":258,"id":261},{"type":205},[259],{"__JSPROSE_element":167,"schemaName":180,"data":260},"BE","emphasis-OVqLqOnxjuuK",{"__JSPROSE_element":167,"schemaName":180,"data":263}," such a project.","paragraph-GaFxwgaPO3PV",{"__JSPROSE_element":167,"schemaName":233,"children":266},[267,276],{"__JSPROSE_element":167,"schemaName":177,"children":268,"id":275},[269],{"__JSPROSE_element":167,"schemaName":203,"data":270,"children":271,"id":274},{"type":205},[272],{"__JSPROSE_element":167,"schemaName":180,"data":273},"All content is free. Forever.","emphasis-QHCIH7JrZY3O","paragraph-sdzml7urAv2c",{"__JSPROSE_element":167,"schemaName":177,"children":277,"id":288},[278,280,286],{"__JSPROSE_element":167,"schemaName":180,"data":279},"No \"trial periods\", paid subscriptions, or other bullshit. All project materials are always available to anyone. We ",{"__JSPROSE_element":167,"schemaName":203,"data":281,"children":282,"id":285},{"type":205,"accent":167},[283],{"__JSPROSE_element":167,"schemaName":180,"data":284},"smash obstacles","emphasis-K4s30TC1fYdu",{"__JSPROSE_element":167,"schemaName":180,"data":287}," to access knowledge, not create new ones.","paragraph-ch3sm55KR9tX",{"__JSPROSE_element":167,"schemaName":233,"children":290},[291,300],{"__JSPROSE_element":167,"schemaName":177,"children":292,"id":299},[293],{"__JSPROSE_element":167,"schemaName":203,"data":294,"children":295,"id":298},{"type":205},[296],{"__JSPROSE_element":167,"schemaName":180,"data":297},"Everyone can contribute.","emphasis-pFDTMBil5Q1X","paragraph-GbANEj6Oywca",{"__JSPROSE_element":167,"schemaName":177,"children":301,"id":312},[302,304,310],{"__JSPROSE_element":167,"schemaName":180,"data":303},"Authors are everyone who has written or proposed decent content. If you have something to add: an interesting problem, a real-life example, a clearer explanation — don't keep it to yourself, ",{"__JSPROSE_element":167,"schemaName":305,"data":306,"storageKey":308,"id":309},"referenceInliner",{"label":307},"make","\u003Clink:external>//contributors/","referenceInliner-Y2iuGWn0nSzf",{"__JSPROSE_element":167,"schemaName":180,"data":311}," \"Open Math\" even better!","paragraph-Qi2RBZxzcHjL","-principles","_principles",{"__JSPROSE_element":167,"schemaName":171,"data":316,"id":318},{"level":173,"title":317},"Who is this site for?","who-is-this-site-for",{"__JSPROSE_element":167,"schemaName":177,"data":320,"children":321,"id":328},{"center":167,"serif":167},[322],{"__JSPROSE_element":167,"schemaName":203,"data":323,"children":324,"id":327},{"type":205},[325],{"__JSPROSE_element":167,"schemaName":180,"data":326},"For everyone who wants to understand math, see its beauty and utility for real life.","emphasis-4lOBpfSb1TDH","paragraph-XSY29kmAnxF3",{"__JSPROSE_element":167,"schemaName":177,"children":330,"id":340},[331,333,338],{"__JSPROSE_element":167,"schemaName":180,"data":332},"What about age? It starts from the ability to self-learn (approx. ",{"__JSPROSE_element":167,"schemaName":334,"data":335,"storageKey":336,"id":337},"inlinerMath","13","$ 13 $","inlinerMath-jdPjRi4YoC5h",{"__JSPROSE_element":167,"schemaName":180,"data":339}," years old) and has no upper limit. The material is presented in a simple format, without abstruse formulations. It will be interesting for both teenagers and adults. In extremely rare cases, you might encounter swear words, but only where it is really needed.","paragraph-elDqli5hC6Ia",{"__JSPROSE_element":167,"schemaName":177,"children":342,"id":353,"uniqueName":354},[343,345,351],{"__JSPROSE_element":167,"schemaName":180,"data":344},"For those who love to cheat — ",{"__JSPROSE_element":167,"schemaName":203,"data":346,"children":347,"id":350},{"type":205},[348],{"__JSPROSE_element":167,"schemaName":180,"data":349},"\"Open Math\" is not a solutions manual!","emphasis-zyFX0fPBiXpz",{"__JSPROSE_element":167,"schemaName":180,"data":352}," You can quickly peek at formulas in Summaries, verify answers to problems in Practicums. But you won't find any \"homework answers pdf\" or \"math answers for grade 7\". Our goal is to teach you to understand the material yourself, derive formulas, and solve problems, not to give ready-made answers!","no-cheating","noCheating",{"__JSPROSE_element":167,"schemaName":171,"data":356,"id":358},{"level":173,"title":357},"The role of \"Math Foundations\"","the-role-of-math-foundations",{"__JSPROSE_element":167,"schemaName":177,"children":360,"id":363},[361],{"__JSPROSE_element":167,"schemaName":180,"data":362},"Starting point for everyone who doesn't know jack about math. It is for those who don't know how to work with fractions or solve equations (or why they are needed at all), who get stumped by roots and powers, for whom the concept of an \"irrational number\" sounds like something from a sci-fi movie, and so on. If any of this (or all at once) applies to you, go here:","paragraph-cx9gEUsRenjC",{"__JSPROSE_element":167,"schemaName":365,"data":366,"storageKey":368,"id":369},"referenceBlock",{"label":367},"Everything most basic, simple, and necessary. Absolutely all other \"Open Math\" materials are written with the expectation that you have firmly grasped these foundations.","\u003Clink:global>/foundations","referenceBlock-114FKQ82ze5R",{"__JSPROSE_element":167,"schemaName":190,"data":371,"children":373,"id":397},{"title":372,"layout":193},"NO links to foundations!",[374],{"__JSPROSE_element":167,"schemaName":196,"children":375},[376],{"__JSPROSE_element":167,"schemaName":177,"children":377,"id":396},[378,380,386,388,394],{"__JSPROSE_element":167,"schemaName":180,"data":379},"In most materials on this site, ",{"__JSPROSE_element":167,"schemaName":203,"data":381,"children":382,"id":385},{"type":205,"accent":167},[383],{"__JSPROSE_element":167,"schemaName":180,"data":384},"you won't find links","emphasis-vah5OoqzhXqb",{"__JSPROSE_element":167,"schemaName":180,"data":387}," to definitions, theorems, and formulas from the \"Math Foundations\" textbook. ",{"__JSPROSE_element":167,"schemaName":203,"data":389,"children":390,"id":393},{"type":205,"accent":167},[391],{"__JSPROSE_element":167,"schemaName":180,"data":392},"This is not a mistake!","emphasis-HmK6rSdwK1ks",{"__JSPROSE_element":167,"schemaName":180,"data":395}," This is considered the knowledge base that every reader should know, understand, and be able to use \"by default\". So we don't have to clutter the text with endless links to elementary stuff.","paragraph-dwt1PzYX1mqc","no-links-to-foundations",{"__JSPROSE_element":167,"schemaName":171,"data":399,"id":401},{"level":173,"title":400},"Links to materials","links-to-materials",{"__JSPROSE_element":167,"schemaName":177,"children":403,"id":414},[404,406,412],{"__JSPROSE_element":167,"schemaName":180,"data":405},"Did you know you can get a direct link to ",{"__JSPROSE_element":167,"schemaName":203,"data":407,"children":408,"id":411},{"type":205},[409],{"__JSPROSE_element":167,"schemaName":180,"data":410},"any element","emphasis-PvvfVZO58HOp",{"__JSPROSE_element":167,"schemaName":180,"data":413}," of any page? Just hover your cursor (or tap) to the left of the element you want to link to, and select \"Copy link\"!","paragraph-RpgYSLMzuwzI",{"__JSPROSE_element":167,"schemaName":416,"data":417,"storageKey":418,"id":420},"video",{"src":418,"autoplay":167,"width":419},"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/link-anywhere.mp4","450px","video-Pw8jjeO55d88",{"__JSPROSE_element":167,"schemaName":177,"children":422,"id":425},[423],{"__JSPROSE_element":167,"schemaName":180,"data":424},"This works even with nested blocks (theorem proofs, problem solutions, etc.)! Very convenient when you need to link to a specific place in the material.","paragraph-inHTvgs0zZ5h",{"__JSPROSE_element":167,"schemaName":171,"data":427,"id":429,"uniqueName":430},{"level":173,"title":428},"How to learn math?","how-to-learn","howToLearn",{"__JSPROSE_element":167,"schemaName":177,"children":432,"id":448},[433,435,438,440,446],{"__JSPROSE_element":167,"schemaName":180,"data":434},"Check the table of contents for what you want to study, and get to it! If you know nothing, then go to ",{"__JSPROSE_element":167,"schemaName":305,"data":436,"storageKey":368,"id":437},{"label":15},"referenceInliner-TueBMcwmjU3t",{"__JSPROSE_element":167,"schemaName":180,"data":439},". Almost all \"Open Math\" study materials consist of ",{"__JSPROSE_element":167,"schemaName":203,"data":441,"children":442,"id":445},{"type":205},[443],{"__JSPROSE_element":167,"schemaName":180,"data":444},"Topics","emphasis-42XoQTLJFyXA",{"__JSPROSE_element":167,"schemaName":180,"data":447},". Each topic is divided into three parts:","paragraph-K7cCqjhO3hT2",{"__JSPROSE_element":167,"schemaName":450,"children":451,"id":459},"diagram",[452,454],{"__JSPROSE_element":167,"schemaName":180,"data":453},"\n        flowchart TD\n          topic[Topic] -->|1. Read and understand| article[**Article**]\n          topic -->|2. Memorize essentials| summary[**Summary**]\n          topic -->|3. Practice skills| practice[**Practice**]\n          class article,summary,practice fill\n      ",{"__JSPROSE_element":167,"schemaName":455,"children":456},"caption",[457],{"__JSPROSE_element":167,"schemaName":180,"data":458},"\"Open Math\" topics structure","diagram-pppjnzKtujed",{"__JSPROSE_element":167,"schemaName":228,"data":461,"children":463,"id":510},{"type":462,"start":173},"ol",[464,477,490],{"__JSPROSE_element":167,"schemaName":233,"children":465},[466],{"__JSPROSE_element":167,"schemaName":177,"children":467,"id":476},[468,474],{"__JSPROSE_element":167,"schemaName":203,"data":469,"children":470,"id":473},{"type":205},[471],{"__JSPROSE_element":167,"schemaName":180,"data":472},"Article.","emphasis-85eOPv1MMdpV",{"__JSPROSE_element":167,"schemaName":180,"data":475}," A detailed and interesting narrative. Its goal is to convey the material to you in every way possible: through examples, different formulations, jokes, and so on. At this stage, you just immerse yourself and delve into the material. You don't need to learn anything by heart!","paragraph-DchoyZFPAtFz",{"__JSPROSE_element":167,"schemaName":233,"children":478},[479],{"__JSPROSE_element":167,"schemaName":177,"children":480,"id":489},[481,487],{"__JSPROSE_element":167,"schemaName":203,"data":482,"children":483,"id":486},{"type":205},[484],{"__JSPROSE_element":167,"schemaName":180,"data":485},"Summary.","emphasis-cB8Qemu0iOpg",{"__JSPROSE_element":167,"schemaName":180,"data":488}," A brief excerpt of the most important points from the article: definitions, theorems, formulas, etc. This is what must firmly remain in your head after studying the material, what needs to be memorized!","paragraph-3njvkMkgBrCP",{"__JSPROSE_element":167,"schemaName":233,"children":491},[492],{"__JSPROSE_element":167,"schemaName":177,"children":493,"id":509},[494,500,502,507],{"__JSPROSE_element":167,"schemaName":203,"data":495,"children":496,"id":499},{"type":205},[497],{"__JSPROSE_element":167,"schemaName":180,"data":498},"Practice.","emphasis-7le9uST5qy5h",{"__JSPROSE_element":167,"schemaName":180,"data":501}," Various problems that will teach you to correctly apply theory in practice. Try to solve everything, even \"sub-problems\" (they get trickier the further you go)! If you couldn't solve a problem and looked at the solution — definitely solve it again immediately and then again the next day! There are more tips, ",{"__JSPROSE_element":167,"schemaName":305,"data":503,"storageKey":505,"id":506},{"label":504},"but not all fit","\u003Clink:global>/faq/$_morePracticeAdvices","referenceInliner-tcfcyOwnqCkF",{"__JSPROSE_element":167,"schemaName":180,"data":508},"...","paragraph-CDDHrh0DaBdL","list-votOdcgVnF2y",{"__JSPROSE_element":167,"schemaName":512,"data":513,"children":515,"id":599,"uniqueName":600},"details",{"title":514},"More practice tips",[516],{"__JSPROSE_element":167,"schemaName":228,"data":517,"children":518,"id":598},{"type":230},[519,526,541,548,561],{"__JSPROSE_element":167,"schemaName":233,"children":520},[521],{"__JSPROSE_element":167,"schemaName":177,"children":522,"id":525},[523],{"__JSPROSE_element":167,"schemaName":180,"data":524},"So you (think you have) solved the problem. Follow the chain of buttons under the problem, from left to right: \"Check\" → \"Hint\" → \"Answer\" → \"Solution\". Do not rush to open, for example, \"Answer\" immediately. First, try to pass the \"Check\" a couple of times, use \"Hints\"!","paragraph-tJnB5Bez0CRf",{"__JSPROSE_element":167,"schemaName":233,"children":527},[528],{"__JSPROSE_element":167,"schemaName":177,"children":529,"id":540},[530,532,538],{"__JSPROSE_element":167,"schemaName":180,"data":531},"Even if you solved the problem correctly yourself, study its \"Solution\" regardless. It is important not only to get the correct answer, but also to understand the ",{"__JSPROSE_element":167,"schemaName":203,"data":533,"children":534,"id":537},{"type":205},[535],{"__JSPROSE_element":167,"schemaName":180,"data":536},"right train of thought","emphasis-vxCInMvBxUk2",{"__JSPROSE_element":167,"schemaName":180,"data":539}," that leads to it!","paragraph-s2IP9c3rbMqy",{"__JSPROSE_element":167,"schemaName":233,"children":542},[543],{"__JSPROSE_element":167,"schemaName":177,"children":544,"id":547},[545],{"__JSPROSE_element":167,"schemaName":180,"data":546},"Be sure to read \"Notes\" to problems! They contain important conclusions, generalizations, or interesting facts.","paragraph-LStjCFTr93dL",{"__JSPROSE_element":167,"schemaName":233,"children":549},[550],{"__JSPROSE_element":167,"schemaName":177,"children":551,"id":560},[552,554],{"__JSPROSE_element":167,"schemaName":180,"data":553},"If you cannot repeat the solution of a problem without peeking into the solution — you have not mastered the material. ",{"__JSPROSE_element":167,"schemaName":203,"data":555,"children":556,"id":559},{"type":205},[557],{"__JSPROSE_element":167,"schemaName":180,"data":558},"Repeat until you solve it yourself!","emphasis-BuI4rnQRk3dg","paragraph-8Eh9LfgYzL2s",{"__JSPROSE_element":167,"schemaName":233,"children":562},[563,568],{"__JSPROSE_element":167,"schemaName":177,"children":564,"id":567},[565],{"__JSPROSE_element":167,"schemaName":180,"data":566},"Problem difficulty levels / Material knowledge levels:","paragraph-dnrah4BhFyAZ",{"__JSPROSE_element":167,"schemaName":177,"children":569,"id":597},[570,576,578,580,586,588,589,595],{"__JSPROSE_element":167,"schemaName":203,"data":571,"children":572,"id":575},{"type":205},[573],{"__JSPROSE_element":167,"schemaName":180,"data":574},"\"Elementary\"","emphasis-gnmFoDbrN2NU",{"__JSPROSE_element":167,"schemaName":180,"data":577}," = most elementary ideas about the material: plug a number into a formula.",{"__JSPROSE_element":167,"schemaName":579},"br",{"__JSPROSE_element":167,"schemaName":203,"data":581,"children":582,"id":585},{"type":205},[583],{"__JSPROSE_element":167,"schemaName":180,"data":584},"\"Intermediate\"","emphasis-csQ0oiJiuDKj",{"__JSPROSE_element":167,"schemaName":180,"data":587}," = normal level of understanding and ability to operate with the material: transform formulas, combine them, solve problems in several steps.",{"__JSPROSE_element":167,"schemaName":579},{"__JSPROSE_element":167,"schemaName":203,"data":590,"children":591,"id":594},{"type":205},[592],{"__JSPROSE_element":167,"schemaName":180,"data":593},"\"Advanced\"","emphasis-m7NSyl6v7iNh",{"__JSPROSE_element":167,"schemaName":180,"data":596}," level (not for everyone) = ability to apply material creatively and non-standardly + olympiad problems.","paragraph-i4TVB2XpY2dh","list-nfy0x4ALdOef","-more-practice-advices","_morePracticeAdvices",{"__JSPROSE_element":167,"schemaName":177,"children":602,"id":605},[603],{"__JSPROSE_element":167,"schemaName":180,"data":604},"Don't even try to learn whole big topics in one day! It's counterproductive. It is better to spend a day on theory, summary, and \"Elementary\" level problems. And then another day/two on \"Intermediate\" level (you can even swing at \"Advanced\", it's cool there). At the same time, start every day by repeating key points from the summary.","paragraph-EEPffItngbB5",{"__JSPROSE_element":167,"schemaName":177,"children":607,"id":622},[608,610,614,616,620],{"__JSPROSE_element":167,"schemaName":180,"data":609},"Get a notebook for solving problems to write everything out by hand, solve, correct, and mark what's important! Just not some lame, flimsy notebook with ",{"__JSPROSE_element":167,"schemaName":334,"data":611,"storageKey":612,"id":613},"25","$ 25 $","inlinerMath-U7E7VqpJu5qq",{"__JSPROSE_element":167,"schemaName":180,"data":615}," pages, but a Notebook with a capital N — with ",{"__JSPROSE_element":167,"schemaName":334,"data":617,"storageKey":618,"id":619},"80","$ 80 $","inlinerMath-PSdY5r1ZLHPX",{"__JSPROSE_element":167,"schemaName":180,"data":621}," pages!","paragraph-4p9JNF1H6toQ",{"__JSPROSE_element":167,"schemaName":184,"data":624,"storageKey":625,"children":626,"id":631},{"src":625,"width":187},"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/right-notebook.webp",[627],{"__JSPROSE_element":167,"schemaName":455,"children":628},[629],{"__JSPROSE_element":167,"schemaName":180,"data":630},"You will have a lot of notes!","image-spVt3mJWElUs",{"__JSPROSE_element":167,"schemaName":171,"data":633,"id":635},{"level":173,"title":634},"How to support the project?","how-to-support-the-project",{"__JSPROSE_element":167,"schemaName":177,"children":637,"id":645},[638,643],{"__JSPROSE_element":167,"schemaName":305,"data":639,"storageKey":641,"id":642},{"label":640},"As already mentioned","\u003Clink:global>/faq/$_principles","referenceInliner-wpL4xA4J52Jj",{"__JSPROSE_element":167,"schemaName":180,"data":644},", the project is not promotional, and all content is completely free. Writing quality and interesting material requires a lot of time. Unfortunately, scientists haven't figured out how to feed people with just \"cool content\" yet (wouldn't that be great?), so this project relies on the financial support of readers like you.","paragraph-UzqGtZCd0M9I",{"__JSPROSE_element":167,"schemaName":184,"data":647,"storageKey":648,"id":649},{"src":648,"width":187},"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/variants-to-donate.webp","image-jC0CFtQ1HbjL",{"__JSPROSE_element":167,"schemaName":177,"children":651,"id":661},[652,654,659],{"__JSPROSE_element":167,"schemaName":180,"data":653},"If you would like to, you can ",{"__JSPROSE_element":167,"schemaName":305,"data":655,"storageKey":657,"id":658},{"label":656},"support the project financially","\u003Clink:external>//sponsors/","referenceInliner-mFJQG3ZLPXEy",{"__JSPROSE_element":167,"schemaName":180,"data":660},". When setting up regular payments, your details (photo/avatar, icon, name, wishes) will be displayed on the sponsors page, as well as at the top of every page of the site materials!","paragraph-LxifTAoGess2",{"__JSPROSE_element":167,"schemaName":177,"children":663,"id":670},[664],{"__JSPROSE_element":167,"schemaName":203,"data":665,"children":666,"id":669},{"type":205},[667],{"__JSPROSE_element":167,"schemaName":180,"data":668},"Help make the best math content! 🤝","emphasis-CczqphvbdwoS","paragraph-9THsM18QIlUQ",{"__JSPROSE_element":167,"schemaName":171,"data":672,"id":674},{"level":173,"title":673},"Who is in charge here?","who-is-in-charge-here",{"__JSPROSE_element":167,"schemaName":177,"children":676,"id":691},[677,679,684,686],{"__JSPROSE_element":167,"schemaName":180,"data":678},"\"The Boss\" is Peter Radko. I developed the engine of this site (and many of its previous iterations), and also wrote most of the materials. The project took more than seven years to reach its current form. For any questions, you can contact me via Telegram ",{"__JSPROSE_element":167,"schemaName":305,"data":680,"storageKey":682,"id":683},{"label":681},"@gwynerva","\u003Clink:external>/https://t.me/gwynerva","referenceInliner-UnABhDesrJaa",{"__JSPROSE_element":167,"schemaName":180,"data":685}," or by email ",{"__JSPROSE_element":167,"schemaName":305,"data":687,"storageKey":689,"id":690},{"label":688},"the.gwynerva@gmail.com","\u003Clink:external>/mailto:the.gwynerva@gmail.com","referenceInliner-V3h2BhXpm0nc","paragraph-fKDFpu3ZV9OQ",{"__JSPROSE_element":167,"schemaName":177,"children":693,"id":702},[694,696,700],{"__JSPROSE_element":167,"schemaName":180,"data":695},"For content questions, besides me, you can contact any \"editor\" whom you can find in the list of ",{"__JSPROSE_element":167,"schemaName":305,"data":697,"storageKey":308,"id":699},{"label":698},"project authors","referenceInliner-FNr4d59k6h5t",{"__JSPROSE_element":167,"schemaName":180,"data":701},".","paragraph-dTLk1mPMo6Jl",{"__JSPROSE_element":167,"schemaName":171,"data":704,"id":706},{"level":173,"title":705},"How does it work?","how-does-it-work",{"__JSPROSE_element":167,"schemaName":177,"children":708,"id":717},[709,711,715],{"__JSPROSE_element":167,"schemaName":180,"data":710},"The project runs on the universal educational site engine ",{"__JSPROSE_element":167,"schemaName":305,"data":712,"storageKey":713,"id":714},{"label":70},"\u003Clink:external>/https://github.com/erudit-js/erudit","referenceInliner-9TbIqWDgjynf",{"__JSPROSE_element":167,"schemaName":180,"data":716},". With its help, you can create \"Open Physics\", \"Open Chemistry\", and any other modern educational projects. There is full support for cross-references with automatic dependency formation, beautiful blocks, diagrams, mathematical formulas, and other cool stuff. The project is open source. Anyone can use it for their own purposes!","paragraph-pYa1jN16Z33P",{"__JSPROSE_element":167,"schemaName":177,"children":719,"id":729},[720,722,727],{"__JSPROSE_element":167,"schemaName":180,"data":721},"The operating principle is very simple. All files are written in TypeScript TSX (a superset of JavaScript), then the Erudit engine processes, analyzes, and turns them into ready-made web pages. ",{"__JSPROSE_element":167,"schemaName":305,"data":723,"storageKey":725,"id":726},{"label":724},"This is how","\u003Clink:external>/https://github.com/open-math/en.omath.net/blob/main/content/00-faq/page.tsx","referenceInliner-GJbIsRM4VHxA",{"__JSPROSE_element":167,"schemaName":180,"data":728}," the source code of this very page you are reading now looks. Everything is beautifully formatted and broken down by tags!","paragraph-qzgbO74GrxO2",{"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/link-anywhere.mp4":731,"\u003Clink:external>//sponsors/":733,"\u003Clink:external>/https://t.me/gwynerva":738,"\u003Clink:external>/mailto:the.gwynerva@gmail.com":741,"\u003Clink:external>//contributors/":744,"\u003Clink:external>/https://github.com/erudit-js/erudit":747,"\u003Clink:external>/https://github.com/open-math/en.omath.net/blob/main/content/00-faq/page.tsx":750,"$ 13 $":753,"$ 25 $":757,"$ 80 $":760,"\u003Clink:global>/faq/$_principles":763,"\u003Clink:global>/faq/$_morePracticeAdvices":768,"\u003Clink:global>/foundations":772,"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/concept.svg":777,"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/right-notebook.webp":781,"/home/runner/work/en.omath.net/en.omath.net/content/00-faq/assets/variants-to-donate.webp":785},{"resolvedSrc":732},"/file/content/00-faq/assets/link-anywhere.mp4",{"type":734,"resolvedHref":735,"previewRequest":736},"external","/sponsors/",{"type":737,"href":735},"direct-link",{"type":734,"resolvedHref":739,"previewRequest":740},"https://t.me/gwynerva",{"type":737,"href":739},{"type":734,"resolvedHref":742,"previewRequest":743},"mailto:the.gwynerva@gmail.com",{"type":737,"href":742},{"type":734,"resolvedHref":745,"previewRequest":746},"/contributors/",{"type":737,"href":745},{"type":734,"resolvedHref":748,"previewRequest":749},"https://github.com/erudit-js/erudit",{"type":737,"href":748},{"type":734,"resolvedHref":751,"previewRequest":752},"https://github.com/open-math/en.omath.net/blob/main/content/00-faq/page.tsx",{"type":737,"href":751},{"type":180,"tokens":754},[755],{"type":756,"value":335},"other",{"type":180,"tokens":758},[759],{"type":756,"value":611},{"type":180,"tokens":761},[762],{"type":756,"value":617},{"type":764,"schemaName":228,"content":765,"resolvedHref":766,"previewRequest":767},"unique",{"contentType":8,"contentTitle":10},"/page/faq/#-principles",{"type":764,"contentFullId":9,"contentType":8,"uniqueName":314},{"type":764,"schemaName":512,"elementTitle":514,"content":769,"resolvedHref":770,"previewRequest":771},{"contentType":8,"contentTitle":10},"/page/faq/#-more-practice-advices",{"type":764,"contentFullId":9,"contentType":8,"uniqueName":600},{"type":773,"content":774,"resolvedHref":17,"previewRequest":775},"contentItem",{"contentType":14,"contentTitle":15},{"type":776,"contentType":14,"fullId":5},"content-page",{"resolvedSrc":778,"width":779,"height":780},"/file/content/00-faq/assets/concept.svg",3762,1327,{"resolvedSrc":782,"width":783,"height":784},"/file/content/00-faq/assets/right-notebook.webp",1000,357,{"resolvedSrc":786,"width":787,"height":788},"/file/content/00-faq/assets/variants-to-donate.webp",1442,554,[790,796,803,809,815,821],{"link":791,"schemaName":190,"title":192,"quick":792,"seo":794,"description":795},"/page/faq/#goal",{"title":793},"Project goal",{"title":192},"To become the ideal and unified resource for self-study of mathematics.\n          So that anyone can understand the theory (in Articles), remember key points (in Summaries), and comprehensively practice applying the knowledge to problems (in Practicums).",{"link":797,"schemaName":177,"title":798,"quick":799,"seo":800,"description":802},"/page/faq/#no-cheating","This is not a cheat sheet!",{},{"title":801},"\"Open Math\" is not a cheat sheet!","The goal of \"Open Math\" is to teach you to understand the material yourself,\n          derive formulas, and solve problems, not to give ready-made answers!",{"link":804,"schemaName":171,"title":400,"quick":805,"seo":807,"description":808},"/page/faq/#links-to-materials",{"title":806},"Links anywhere",{},"You can link not only to the page entirely, but to any element inside it!",{"link":810,"schemaName":171,"title":428,"quick":811,"seo":813,"description":814},"/page/faq/#how-to-learn",{"title":812},"How to learn?",{},"Theory (Understand) → Summary (Memorize) → Practice (Consolidate).\n          Solve all problems.",{"link":816,"schemaName":171,"title":634,"quick":817,"seo":819,"description":820},"/page/faq/#how-to-support-the-project",{"title":818},"Support the project!",{},"Help us become even better! Suggest content or make a donation.",{"link":822,"schemaName":171,"title":673,"quick":823,"seo":825},"/page/faq/#who-is-in-charge-here",{"title":824},"How to contact?",{},[827,829,831,833,835,837,839,841],{"type":171,"level":173,"title":174,"elementId":175,"children":828},[],{"type":171,"level":173,"title":317,"elementId":318,"children":830},[],{"type":171,"level":173,"title":357,"elementId":358,"children":832},[],{"type":171,"level":173,"title":400,"elementId":401,"children":834},[],{"type":171,"level":173,"title":428,"elementId":429,"children":836},[],{"type":171,"level":173,"title":634,"elementId":635,"children":838},[],{"type":171,"level":173,"title":673,"elementId":674,"children":840},[],{"type":171,"level":173,"title":705,"elementId":706,"children":842},[],{"contributorsCount":173,"sponsorsCount":844},0,{"cameo":846},[847,848,849,850,851,852,853,854,855],"cameo-black-hole","cameo-confucius","cameo-dunno","cameo-einstein","cameo-euclid","cameo-gagarin","cameo-gauss","cameo-newton","cameo-t800",1770565563296]