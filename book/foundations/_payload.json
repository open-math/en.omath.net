ow",{"type":21,"value":120},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":16,"value":122},"Depends on",{"type":16,"value":124},"Used by",{"type":16,"value":126},"Externals",{"m":128},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":130,"mainContent":131},"book/foundations/",{"fullId":5,"shortId":5,"contentRelativePath":132,"title":9,"bookTitle":9,"breadcrumbs":133,"description":134,"stats":135,"connections":142,"contributions":153,"type":8,"children":158},"01-foundations",[],"\n        All the foundational and most useful topics, formulas, and concepts on which all of mathematics is built.\n        The perfect starting point if you are a complete beginner in mathematics.\n        No prior knowledge required!\n        Everything is explained in a simple and understandable language.\n    ",{"materials":136,"elements":137},2,{"accent_term":138,"accent_statement":139,"accent_important":140,"problem":141},3,1,4,35,{"externals":143},[144],{"type":145,"items":146},"own",[147],{"type":148,"title":149,"info":150,"link":151,"reason":152},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[154],{"contributorId":155,"name":156,"avatarUrl":157},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png",[159],{"type":160,"link":161,"title":162,"description":163,"stats":164},"group","/group/foundations/equations/","Equations","\n        Analysis of the most popular equations: elementary, quadratic, systems, etc.\n        You will understand why they need to be solved at all and how they can be used to describe processes in real life.\n        We will also consider nuances: transformations, domain restrictions, \"loss\" and appearance of \"extraneous\" roots, and many others.\n    ",{"materials":136,"elements":165},{"accent_term":138,"accent_statement":139,"accent_important":140,"problem":141},{"contributorsCount":139,"sponsorsCount":167},0,{"shortBookId":5,"frontNav":169},{"type":8,"shortId":5,"title":9,"flags":170,"link":11,"children":171},{},[172],{"type":160,"separator":173,"shortId":174,"title":162,"flags":175,"link":161,"children":176},true,"foundations/equations",{},[177,183],{"type":178,"shortId":179,"title":180,"flags":181,"link":182},"topic","foundations/equations/elementary","Elementary Equations",{},"/article/foundations/equations/elementary/",{"type":160,"separator":184,"shortId":185,"title":186,"flags":187,"link":188,"children":189},false,"foundations/equations/quadratic","Quadratic Equations",{},"/group/foundations/equations/quadratic/",[190],{"type":178,"shortId":191,"title":192,"flags":193,"link":194},"foundations/equations/quadratic/basics","Quadratic Equations Basics",{},"/article/foundations/equations/quadratic/basics/",1769271203869]