e":21,"value":120},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":16,"value":122},"Depends on",{"type":16,"value":124},"Used by",{"type":16,"value":126},"Externals",{"m":128},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":130,"mainContent":131},"group/basics/equations/",{"fullId":132,"shortId":132,"contentRelativePath":133,"title":134,"bookTitle":9,"breadcrumbs":135,"description":138,"stats":139,"connections":146,"contributions":157,"type":162,"children":163},"basics/equations","01-basics/02-equations","Equations",[136],{"icon":137,"title":9,"link":11},"book-outline","\n        Analysis of the most popular equations: elementary, quadratic, systems, etc.\n        You will understand why they need to be solved at all and how they can be used to describe processes in real life.\n        We will also consider nuances: transformations, domain restrictions, \"loss\" and appearance of \"extraneous\" roots, and many others.\n    ",{"materials":140,"elements":141},2,{"accent_term":142,"accent_statement":143,"accent_important":144,"problem":145},3,1,4,35,{"externals":147},[148],{"type":149,"title":9,"items":150},"parent",[151],{"type":152,"title":153,"info":154,"link":155,"reason":156},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[158],{"contributorId":159,"name":160,"avatarUrl":161},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[164,244],{"type":165,"link":166,"title":167,"description":168,"quickLinks":169,"stats":242},"topic","/article/basics/equations/elementary/","Elementary Equations","\n        We will learn how to solve elementary equations and transform equalities.\n        Simple, visual, with examples and without memorizing a bunch of strange rules.\n        This is a key and necessary skill in mathematics and all other exact sciences.\n    ",[170,178,185,192,199,206,214,221,228,235],{"link":171,"schemaName":172,"title":173,"quick":174,"seo":175,"description":177},"/article/basics/equations/elementary/#equality","accent_term","Equality",{},{"title":176},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":179,"schemaName":180,"title":181,"quick":182,"seo":183,"description":184},"/article/basics/equations/elementary/#equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different — false.",{"link":186,"schemaName":172,"title":187,"quick":188,"seo":189,"description":191},"/article/basics/equations/elementary/#equation","Equation",{},{"title":190},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":193,"schemaName":172,"title":194,"quick":195,"seo":196,"description":198},"/article/basics/equations/elementary/#equation-solution","Solving an Equation",{},{"title":197},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n                    \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":200,"schemaName":201,"title":202,"quick":203,"seo":204,"description":205},"/article/basics/equations/elementary/#same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":207,"schemaName":208,"title":209,"quick":210,"seo":211,"description":213},"/article/basics/equations/elementary/#common-mistakes","list","Mistakes when solving equations",{},{"title":212},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":215,"schemaName":216,"title":217,"quick":218,"seo":219,"description":220},"/article/basics/equations/elementary/#why-solve-equations-1","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":222,"schemaName":216,"title":223,"quick":224,"seo":225,"description":227},"/article/basics/equations/elementary/#triangle-of-formulas","Triangle of Formulas",{},{"title":226},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":229,"schemaName":216,"title":230,"quick":231,"seo":232,"description":234},"/article/basics/equations/elementary/#equations-in-life","Equations in Life",{},{"title":233},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":236,"schemaName":237,"title":238,"quick":239,"seo":240,"description":241},"/practice/basics/equations/elementary/#linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":243},{"accent_term":142,"accent_statement":143,"accent_important":144,"problem":145},{"type":162,"link":245,"title":246,"stats":247},"/group/basics/equations/quadratic/","Quadratic Equations",{"materials":143},{"contributorsCount":143,"sponsorsCount":249},0,{"shortBookId":5,"frontNav":251},{"type":8,"shortId":5,"title":9,"flags":252,"link":11,"children":253},{},[254],{"type":162,"separator":255,"shortId":132,"title":134,"flags":256,"link":257,"children":258},true,{},"/group/basics/equations/",[259,262],{"type":165,"shortId":260,"title":167,"flags":261,"link":166},"basics/equations/elementary",{},{"type":162,"separator":263,"shortId":264,"title":246,"flags":265,"link":245,"children":266},false,"basics/equations/quadratic",{},[267],{"type":165,"shortId":268,"title":269,"flags":270,"link":271},"basics/equations/quadratic/basics","Quadratic Equations Basics",{},"/article/basics/equations/quadratic/basics/",1769256341002]