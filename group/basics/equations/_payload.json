e":21,"value":120},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":16,"value":122},"Depends on",{"type":16,"value":124},"Used by",{"type":16,"value":126},"Externals",{"m":128},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":130,"mainContent":131},"group/basics/equations/",{"fullId":132,"shortId":132,"contentRelativePath":133,"title":134,"bookTitle":9,"breadcrumbs":135,"description":138,"stats":139,"connections":146,"contributions":166,"type":171,"children":172},"basics/equations","01-basics/02-equations","Уравнения",[136],{"icon":137,"title":9,"link":11},"book-outline","\n        Разбор самых популярных уравнений: элементарных, квадратных, систем и т.д.\n        Вы поймёте, зачем их вообще нужно решать и как с их помощью можно описывать процессы в реальной жизни.\n        Разберем и нюансы: преобразования, ОДЗ, \"потеря\" и появление \"лишних\" корней и многие другие.\n    ",{"materials":140,"elements":141},2,{"accent_term":142,"accent_statement":143,"accent_important":144,"problem":145},3,1,4,35,{"externals":147},[148,157],{"type":149,"items":150},"own",[151],{"type":152,"title":153,"info":154,"link":155,"reason":156},"physical","Задачи на составление уравнений и методы их решения","Крамор В. С., (Школьный курс математики)","https://ddpu.edu.ua/fmk/studentam/3em/10.pdf","Больше 300 задач на сведение жизненных ситуаций к уравнениям вместе с решениями и ответами.",{"type":158,"title":9,"items":159},"parent",[160],{"type":161,"title":162,"info":163,"link":164,"reason":165},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[167],{"contributorId":168,"name":169,"avatarUrl":170},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[173,253],{"type":174,"link":175,"title":176,"description":177,"quickLinks":178,"stats":251},"topic","/article/basics/equations/elementary/","Элементарные уравнения","\n        Научимся решать простейшие уравнения и преобразовывать равенства.\n        Просто, наглядно, с примерами и без заучивания наизусть кучи странных правил.\n        Это ключевой и необходимый навык в математике и всех остальных точных науках.\n    ",[179,187,194,201,208,215,223,230,237,244],{"link":180,"schemaName":181,"title":182,"quick":183,"seo":184,"description":186},"/article/basics/equations/elementary/#equality","accent_term","Равенство",{},{"title":185},"Что такое равенство?","Два выражения, между которыми стоит знак равно \"=\". Равенство может быть истинным (2 = 2) или ложным (2 = 0).",{"link":188,"schemaName":189,"title":190,"quick":191,"seo":192,"description":193},"/article/basics/equations/elementary/#equality-false-true","diagram","Верное и ложное равенство",{},{},"Если по бокам от знака = стоят одинаковые объекты, то равенство верное. Если разные — ложное.",{"link":195,"schemaName":181,"title":196,"quick":197,"seo":198,"description":200},"/article/basics/equations/elementary/#equation","Уравнение",{},{"title":199},"Что такое уравнение?","Равенство, в котором есть одна или несколько неизвестных или переменных.",{"link":202,"schemaName":181,"title":203,"quick":204,"seo":205,"description":207},"/article/basics/equations/elementary/#equation-solution","Решение уравнения",{},{"title":206},"Что значит решить уравнение?","\"Решения\" или \"корни\" уравнения — числа, которые при подстановке вместо неизвестных превращают его в истинное равенство.\n                    \"Решить уравнение\" — значит найти все его корни и доказать, что других корней нет.",{"link":209,"schemaName":210,"title":211,"quick":212,"seo":213,"description":214},"/article/basics/equations/elementary/#same-action-rule","accent_statement","Правило одинакового действия",{},{},"Если над обеими частями истинного равенства совершить одно и то же действие, то полученное равенство тоже будет истинным.",{"link":216,"schemaName":217,"title":218,"quick":219,"seo":220,"description":222},"/article/basics/equations/elementary/#common-mistakes","list","Ошибки при решении уравнений",{},{"title":221},"Типовые ошибки при решении уравнений","Список типовых ошибок, которые новички совершают при решении уравнений.",{"link":224,"schemaName":225,"title":226,"quick":227,"seo":228,"description":229},"/article/basics/equations/elementary/#heading-e9kTE7l3MKlJ","heading","Зачем решать уравнения?",{},{},"Набор примеров, для работы с которыми требуется умение решать уравнения.",{"link":231,"schemaName":225,"title":232,"quick":233,"seo":234,"description":236},"/article/basics/equations/elementary/#heading-5Bb4SLRb4Twr","Треугольник формул",{},{"title":235},"Магический треугольник формул","Мнемоническая техника для запоминания простых формул.",{"link":238,"schemaName":225,"title":239,"quick":240,"seo":241,"description":243},"/article/basics/equations/elementary/#heading-Uc37AakNT4kL","Уравнения в жизни",{},{"title":242},"Где используют уравнения в жизни?","Подборка проблем и ситуаций из реальной жизни, которые можно решить, если перевести их в уравнения.",{"link":245,"schemaName":246,"title":247,"quick":248,"seo":249,"description":250},"/practice/basics/equations/elementary/#linear-root","problems","Формула линейных уравнений",{},{},"Формула, по которой можно очень быстро найти корень любого уравнения вида Ax + B = 0.",{"elements":252},{"accent_term":142,"accent_statement":143,"accent_important":144,"problem":145},{"type":171,"link":254,"title":255,"stats":256},"/group/basics/equations/quadratic/","Квадратные уравнения",{"materials":143},{"contributorsCount":143,"sponsorsCount":258},0,{"shortBookId":5,"frontNav":260},{"type":8,"shortId":5,"title":9,"flags":261,"link":11,"children":262},{},[263],{"type":171,"separator":264,"s