e project.`",{"type":22,"value":122},"Breadcrumb",{"type":22,"value":124},"Begin Learning!",{"type":22,"value":126},"Connections",{"type":22,"value":128},"Updated",{"type":22,"value":130},"Own",{"type":22,"value":132},"From",{"type":22,"value":134},"Need to know",{"type":22,"value":136},"Depends on",{"type":22,"value":138},"Used by",{"type":22,"value":140},"Externals",{"m":142},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":144,"mainContent":145},"group\u002Ffoundations\u002Fpolynomials\u002F",{"fullId":146,"shortId":146,"contentRelativePath":147,"title":148,"bookTitle":15,"breadcrumbs":149,"lastmod":152,"description":153,"stats":154,"connections":160,"contributions":187,"type":192,"children":193},"foundations\u002Fpolynomials","01-foundations\u002F01-polynomials","Polynomials",[150],{"icon":151,"title":15,"link":17},"book-outline","2026-05-01T19:02:45+03:00","\n    Core ideas around monomials and polynomials.\n    Learn how to rewrite them into standard form, transform them, factor them, and use the most common algebraic identities.\n  ",{"materials":155,"elements":156},1,{"accent_term":155,"accent_statement":157,"accent_important":158,"problem":159},5,2,25,{"dependents":161,"externals":177},[162],{"type":163,"contentType":164,"title":165,"link":166,"uniques":167},"auto","topic","Completing the Square","\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fcompleting-the-square\u002F",[168,173],{"name":169,"title":170,"link":171,"schemaName":172},"squareSum","Square of a sum formula","\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=square-sum","accent_statement",{"name":174,"title":175,"link":176,"schemaName":172},"squareDiff","Square of a difference formula","\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=square-diff",[178],{"type":179,"title":15,"items":180},"parent",[181],{"type":182,"title":183,"info":184,"link":185,"reason":186},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[188],{"contributorId":189,"name":190,"avatarUrl":191},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[194],{"type":164,"link":195,"title":196,"description":197,"decoration":198,"keyLinks":199,"stats":259},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F","Special Products","\n    Square of a sum and a difference, difference of squares, and cube of a sum and a difference -- very useful formulas\n    that let you quickly expand or factor expressions with powers.\n  ","content\u002F01-foundations\u002F01-polynomials\u002F01-special-products\u002Fdecoration.svg",[200,207,212,217,225,231,237,243,251],{"link":201,"schemaName":202,"title":196,"key":203,"seo":205,"description":206},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=what-are-special-products","accent_term",{"title":204},"What are Special Products?",{},"Formulas that let you quickly \"unpack\" compact powered expressions into expansions or, going the other way,\n          \"pack\" long sums into a compact form. These formulas save you from doing routine calculations by hand.",{"link":171,"schemaName":172,"title":208,"key":209,"seo":210,"description":211},"Square of a Sum",{},{},"One of the Special Products formulas: (a+b)² = a² + 2ab + b².\n          It lets you quickly expand brackets or, the other way around, pack an expanded expression back into them.",{"link":176,"schemaName":172,"title":213,"key":214,"seo":215,"description":216},"Square of a Difference",{},{},"One of the Special Products formulas: (a-b)² = a² - 2ab + b².\n          It lets you expand parentheses quickly or, going the other way, factor an expression back into squared parentheses.",{"link":218,"schemaName":219,"title":220,"key":221,"seo":222,"description":224},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=fast-square","problems","Quick Squares",{},{"title":223},"How can you square a number quickly in your head?","A universal method for quickly squaring any number by using the square-of-a-sum and square-of-a-difference formulas.\n          For numbers within 100, this process can often be done mentally.",{"link":226,"schemaName":172,"title":227,"key":228,"seo":229,"description":230},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=diff-of-squares","Difference of Squares",{},{},"One of the Special Products formulas: a² - b² = (a + b)(a - b).\n          Lets you halve or double the degree.\n          Used to simplify expressions.",{"link":232,"schemaName":172,"title":233,"key":234,"seo":235,"description":236},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=cube-sum","Cube of a Sum",{},{},"One of the Special Products formulas: (a + b)³ = a³ + 3a²b + 3ab² + b³.\n          Lets you quickly expand the cube of a sum of two expressions.\n          Used to simplify expressions and solve equations.",{"link":238,"schemaName":172,"title":239,"key":240,"seo":241,"description":242},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=cube-diff","Cube of a Difference",{},{},"One of the Special Products formulas: (a - b)³ = a³ - 3a²b + 3ab² - b³.\n          Lets you quickly expand the cube of a difference of two expressions.\n          Used to simplify expressions and solve equations.",{"link":244,"schemaName":245,"title":246,"key":247,"seo":248,"description":250},"\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=memorization-tips","list","How to memorize?",{},{"title":249},"How to memorize Special Products?","A set of tips and tricks that help you memorize Special Products and avoid mixing them up.",{"link":252,"schemaName":253,"title":254,"key":255,"seo":257,"description":258},"\u002Fsummary\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=special-products-table","table","Table of Special Products",{"title":256},"Special Products table",{},"A single table with all the Special Products formulas.",{"elements":260},{"accent_term":155,"accent_statement":157,"accent_important":158,"problem":159},{"contributorsCount":155,"sponsorsCount":262},0,{"shortBookId":5,"frontNav":264},{"type":14,"shortId":5,"title":15,"flags":265,"link":17,"children":266},{},[267,279],{"type":192,"separator":268,"shortId":146,"title":148,"flags":269,"link":270,"children":271},true,{},"\u002Fgroup\u002Ffoundations\u002Fpolynomials\u002F",[272],{"type":164,"shortId":273,"title":196,"flags":274,"link":195,"parts":275},"foundations\u002Fpolynomials\u002Fspecial-products",{},[276,277,278],"article","summary","practice",{"type":192,"separator":268,"shortId":280,"title":281,"flags":282,"link":283,"children":284},"foundations\u002Fequations","Equations",{},"\u002Fgroup\u002Ffoundations\u002Fequations\u002F",[285,291,296,354],{"type":164,"shortId":286,"title":287,"flags":288,"link":289,"parts":290},"foundations\u002Fequations\u002Felementary","Elementary Equations",{},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F",[276,277,278],{"type":8,"shortId":292,"title":293,"flags":294,"link":295},"foundations\u002Fequations\u002Fzero-product-property","Zero Product Property",{},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F",{"type":192,"separator":297,"shortId":298,"title":299,"flags":300,"link":301,"children":302},false,"foundations\u002Fequations\u002Fquadratic","Quadratic Equations",{},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F",[303,309,315,319,325,331,336,342,348],{"type":164,"shortId":304,"title":305,"flags":306,"link":307,"parts":308},"foundations\u002F