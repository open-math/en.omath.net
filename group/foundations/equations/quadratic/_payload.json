ns","/group/foundations/equations/","\n        A comprehensive overview of quadratic equations: quadratic trinomials, completing the square, discriminant,\n        Vieta's formulas, factoring, real-life applications, and even methods for solving them quickly in your head!\n    ",{"materials":159,"elements":160},1,{"accent_term":161,"accent_important":159,"problem":161},2,{"hardDependencies":163,"autoDependencies":170,"externals":173},[164],{"type":165,"contentType":166,"title":167,"link":168,"reason":169},"hard","topic","Elementary Equations","/article/foundations/equations/elementary/","Before solving quadratic equations, you must be able to solve elementary ones. There is no other way. Don't even try.",[171],{"type":172,"contentType":166,"title":167,"link":168},"auto",[174],{"type":175,"title":9,"items":176},"parent",[177],{"type":178,"title":179,"info":180,"link":181,"reason":182},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[184],{"contributorId":185,"name":186,"avatarUrl":187},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[190],{"type":166,"link":191,"title":192,"description":193,"quickLinks":194,"stats":217},"/article/foundations/equations/quadratic/what-is-it/","What is it?","\n        Let's figure out what a quadratic equation and a quadratic trinomial are.\n        How these terms appeared, how they are similar, and how they differ.\n        Learn to determine whether an equation is quadratic.\n    ",[195,202,210],{"link":196,"schemaName":197,"title":198,"quick":199,"seo":200,"description":201},"/article/foundations/equations/quadratic/what-is-it/#problematic-equations","heading","Quadratic equations in real life",{},{},"Examples of various real-life situations that boil down to quadratic equations.\n                    This will make it clear why we need to be able to solve them at all.",{"link":203,"schemaName":204,"title":205,"quick":206,"seo":207,"description":209},"/article/foundations/equations/quadratic/what-is-it/#quadratic-polynomial","accent_term","Quadratic trinomial",{},{"title":208},"What is a quadratic trinomial?","Polynomial with the maximum power of the unknown equal to two.\n                    Acts as a \"template\" or \"general form\" for all quadratic equations.",{"link":211,"schemaName":204,"title":212,"quick":213,"seo":214,"description":216},"/article/foundations/equations/quadratic/what-is-it/#quadratic-equation","Quadratic equation",{},{"title":215},"What is a quadratic equation?","Any equation that can be reduced to the form of a quadratic trinomial by transformations without losing roots.",{"elements":218},{"accent_term":161,"accent_important":159,"problem":161},{"contributorsCount":159,"sponsorsCount":220},0,{"shortBookId":5,"frontNav":222},{"type":8,"shortId":5,"title":9,"flags":223,"link":11,"children":224},{},[225],{"type":188,"separator":226,"shortId":227,"title":155,"flags":228,"link":156,"children":229},true,"foundations/equations",{},[230,233,241],{"type":166,"shortId":231,"title":167,"flags":232,"link":168},"foundations/equations/elementary",{},{"type":188,"separator":234,"shortId":147,"title":149,"flags":235,"link":236,"children":237},false,{},"/group/foundations/equations/quadratic/",[238],{"type":166,"shortId":239,"title":192,"flags":240,"link":191},"foundations/equations/quadratic/what-is-it",{},{"type":166,"shortId":242,"title":243,"flags":244,"link":245},"foundations/equations/equivalence","Equivalence of equations",{"dev":226},"/article/foundations/equations/equivalence/",1769619011179]