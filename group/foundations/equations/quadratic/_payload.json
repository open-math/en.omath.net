n",{"type":23,"value":119},"There are no sponsors yet. You can be the first one!",{"type":23,"value":97},{"type":23,"value":122},"Key elements",{"type":23,"value":124},"Connections",{"type":23,"value":126},"Begin Learning!",{"type":23,"value":128},"This material is for learners with a high level of knowledge. It contains information that is not suitable for beginners!",{"type":23,"value":130},"Need to know",{"type":23,"value":95},{"type":23,"value":133},"Depends on",{"type":23,"value":135},"This material is in development! It may change in the future and even contain errors!",{"type":23,"value":137},"Used by",{"type":23,"value":99},{"type":23,"value":140},"Externals",{"type":23,"value":142},"This is an optional material is for learners who want to dive deeper and gain additional knowledge and context.",{"type":28,"value":144},"(contentTitle) => `Clear and interesting explanation of the topic \"${contentTitle}\". Clear examples, important terms and statements, interesting facts, life applications.`",{"m":146},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":148,"mainContent":149},"group/foundations/equations/quadratic/",{"fullId":150,"shortId":150,"contentRelativePath":151,"title":152,"bookTitle":16,"breadcrumbs":153,"description":160,"decoration":161,"stats":162,"connections":167,"contributions":190,"type":195,"children":196},"foundations/equations/quadratic","01-foundations/02-equations/02-quadratic","Quadratic Equations",[154,156],{"icon":155,"title":16,"link":18},"book-outline",{"icon":157,"title":158,"link":159},"folder-open","Equations","/group/foundations/equations/","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta’s formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ","content/01-foundations/02-equations/02-quadratic/decoration.svg",{"materials":163,"elements":164},2,{"accent_term":165,"accent_statement":165,"accent_important":163,"problem":166},3,12,{"hardDependencies":168,"externals":175},[169],{"type":170,"contentType":171,"title":172,"link":173,"reason":174},"hard","topic","Elementary Equations","/article/foundations/equations/elementary/","Before solving quadratic equations, you must be able to solve elementary ones. There is no other way. Don't even try.",[176],{"type":177,"title":16,"items":178},"parent",[179,184],{"type":180,"title":181,"info":182,"reason":183},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":185,"title":186,"info":187,"link":188,"reason":189},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[191],{"contributorId":192,"name":193,"avatarUrl":194},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[197,227],{"type":171,"link":198,"title":199,"description":200,"quickLinks":201,"stats":223},"/article/foundations/equations/quadratic/what-is-it/","What is it?","\n    Learn how quadratic equations arise from real-life situations,\n    what quadratic equations and quadratic trinomials are,\n    how they are related, and how to determine whether an equation is quadratic.\n  ",[202,209,217],{"link":203,"schemaName":204,"title":205,"quick":206,"seo":207,"description":208},"/article/foundations/equations/quadratic/what-is-it/#problematic-equations","problems","Quadratic equations in real life",{},{},"Examples of various real-life situations that boil down to quadratic equations.\n          This will make it clear why we need to be able to solve them at all.",{"link":210,"schemaName":211,"title":212,"quick":213,"seo":214,"description":216},"/article/foundations/equations/quadratic/what-is-it/#quadratic-trinomial","accent_term","Quadratic trinomial",{},{"title":215},"What is a quadratic trinomial?","Polynomial with the maximum power of the variable equal to two.\n          Acts as a \"template\" or \"general form\" for all quadratic equations.",{"link":218,"schemaName":211,"title":219,"quick":220,"seo":221,"description":222},"/article/foundations/equations/quadratic/what-is-it/#quadratic-equation","Quadratic equation",{},{},"Any equation that can be reduced to the form of a quadratic trinomial by transformations without losing roots.",{"elements":224},{"accent_term":163,"accent_important":225,"problem":226},1,5,{"type":171,"link":228,"title":229,"description":230,"quickLinks":231,"stats":256},"/article/foundations/equations/quadratic/incomplete/","With missing terms","\n    Quadratic equations with missing terms (incomplete quadratics) are the simplest forms of quadratic equations where the coefficient B, C, or both are missing.\n    Let's learn how to solve them correctly in each specific case.\n  ",[232,239,247],{"link":233,"schemaName":211,"title":234,"quick":235,"seo":236,"description":238},"/article/foundations/equations/quadratic/incomplete/#quadratic-missing-terms","Incomplete quadratic equation",{},{"title":237},"What is an incomplete quadratic equation?","A quadratic equation in which coefficient B or C or both are zero.",{"link":240,"schemaName":241,"title":242,"quick":243,"seo":244,"description":246},"/article/foundations/equations/quadratic/incomplete/#solving-such-equations","heading","Solving such equations",{},{"title":245},"How to solve incomplete quadratic equations?","Detailed analysis of solving all types of incomplete quadratic equations with derivation of general formulas.",{"link":248,"schemaName":249,"title":250,"quick":251,"seo":253,"description":255},"/summary/foundations/equations/quadratic/incomplete/#all-formulas","diagram","General formulas for incomplete quadratic equations",{"title":252},"General formulas",{"title":254},"General formulas for solving incomplete quadratic equations","Formulas for all three types of incomplete quadratic equations:\n          when \"B\" and \"C\" are zero, when \"C\" is zero, and when \"B\" is zero.",{"elements":257},{"accent_term":225,"accent_statement":165,"accent_important":225,"problem":258},7,{"contributorsCount":225,"sponsorsCount":260},0,{"shortBookId":5,"frontNav":262},{"type":15,"shortId":5,"title":16,"flags":263,"link":18,"children":264},{},[265],{"type":195,"separator":12,"shortId":266,"title":158,"flags":267,"link":159,"children":268},"foundations/equations",{},[269,272,283],{"type":171,"shortId":270,"title":172,"flags":271,"link":173},"foundations/equations/elementary",{},{"type":195,"separator":273,"shortId":150,"title":152,"flags":274,"link":275,"children":276},false,{},"/group/foundations/equations/quadratic/",[277,280],{"type":171,"shortId":278,"title":199,"flags":279,"link":198},"foundations/equations/quadratic/what-is-it",{},{"type":171,"shortId":281,"title":229,"flags":282,"link":228},"foundations/equations/quadratic/incomplete",{},{"type":171,"shortId":284,"title":285,"flags":286,"link":287},"foundations/equations/equivalence","Equivalence of equations",{"dev":12},"/article/foundations/equations/equivalence/",1770296904285]