pe":22,"value":122},"Begin Learning!",{"type":22,"value":124},"Connections",{"type":22,"value":126},"Updated",{"type":22,"value":128},"Own",{"type":22,"value":130},"From",{"type":22,"value":132},"Need to know",{"type":22,"value":134},"Depends on",{"type":22,"value":136},"Used by",{"type":22,"value":138},"Externals",{"m":140},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":142,"mainContent":143},"group\u002Ffoundations\u002Fequations\u002F",{"fullId":144,"shortId":144,"contentRelativePath":145,"title":146,"bookTitle":15,"breadcrumbs":147,"lastmod":150,"description":151,"stats":152,"connections":158,"contributions":177,"type":182,"children":183},"foundations\u002Fequations","01-foundations\u002F02-equations","Equations",[148],{"icon":149,"title":15,"link":17},"book-outline","2026-03-23T16:32:15+03:00","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":153,"elements":154},9,{"accent_term":153,"accent_statement":155,"accent_important":156,"problem":157},8,14,101,{"externals":159},[160,168],{"type":161,"items":162},"own",[163],{"type":164,"title":165,"info":166,"reason":167},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":169,"title":15,"items":170},"parent",[171],{"type":172,"title":173,"info":174,"link":175,"reason":176},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[178],{"contributorId":179,"name":180,"avatarUrl":181},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[184,268,289,298],{"type":185,"link":186,"title":187,"description":188,"keyLinks":189,"stats":262},"topic","\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[190,198,205,212,219,226,234,241,248,255],{"link":191,"schemaName":192,"title":193,"key":194,"seo":195,"description":197},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality","accent_term","Equality",{},{"title":196},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":199,"schemaName":200,"title":201,"key":202,"seo":203,"description":204},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":206,"schemaName":192,"title":207,"key":208,"seo":209,"description":211},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation","Equation",{},{"title":210},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":213,"schemaName":192,"title":214,"key":215,"seo":216,"description":218},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation-solution","Solving an Equation",{},{"title":217},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":220,"schemaName":221,"title":222,"key":223,"seo":224,"description":225},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":227,"schemaName":228,"title":229,"key":230,"seo":231,"description":233},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=common-mistakes","list","Mistakes when solving equations",{},{"title":232},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":235,"schemaName":236,"title":237,"key":238,"seo":239,"description":240},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=why-solve-equations","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":242,"schemaName":236,"title":243,"key":244,"seo":245,"description":247},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=the-idiot-s-triangle","Triangle of Formulas",{},{"title":246},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":249,"schemaName":236,"title":250,"key":251,"seo":252,"description":254},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equations-in-life","Equations in Life",{},{"title":253},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":256,"schemaName":257,"title":258,"key":259,"seo":260,"description":261},"\u002Fpractice\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":263},{"accent_term":264,"accent_statement":265,"accent_important":266,"problem":267},3,1,4,35,{"type":8,"link":269,"title":270,"description":271,"keyLinks":272,"stats":287},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F","Zero Product Property","\n    A simple and very effective way to solve equations made of factors (brackets) whose product is zero.\n    You need this method, because a huge number of different equations get reduced to exactly this form.\n  ",[273,279],{"link":274,"schemaName":221,"title":270,"key":275,"seo":276,"description":278},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-method",{},{"title":277},"What is zero product property?","A convenient way to quickly solve equations written as a product of factors equal to zero.",{"link":280,"schemaName":257,"title":281,"key":282,"seo":284,"description":286},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-examples","Practicing zero product property",{"title":283},"Usage examples",{"title":285},"How to use zero product property?","Practice problems for the zero product property with detailed solutions.",{"elements":288},{"accent_statement":265,"problem":265},{"type":182,"link":290,"title":291,"description":292,"stats":293},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta's formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":294,"elements":295},6,{"accent_term":294,"accent_statement":294,"accent_important":296,"problem":297},10,65,{"type":185,"link":299,"title":300},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fequivalence\u002F","Equivalence of equations",{"contributorsCount":265,"sponsorsCount":302},0,{"shortBookId":5,"frontNav":304},{"type":14,"shortId":5,"title":15,"flags":3