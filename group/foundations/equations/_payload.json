e project.`",{"type":22,"value":122},"Breadcrumb",{"type":22,"value":124},"Begin Learning!",{"type":22,"value":126},"Connections",{"type":22,"value":128},"Updated",{"type":22,"value":130},"Own",{"type":22,"value":132},"From",{"type":22,"value":134},"Need to know",{"type":22,"value":136},"Depends on",{"type":22,"value":138},"Used by",{"type":22,"value":140},"Externals",{"m":142},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":144,"mainContent":145},"group\u002Ffoundations\u002Fequations\u002F",{"fullId":146,"shortId":146,"contentRelativePath":147,"title":148,"bookTitle":15,"breadcrumbs":149,"lastmod":152,"description":153,"stats":154,"connections":161,"contributions":197,"type":202,"children":203},"foundations\u002Fequations","01-foundations\u002F02-equations","Equations",[150],{"icon":151,"title":15,"link":17},"book-outline","2026-05-01T19:02:45+03:00","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":155,"elements":156},12,{"accent_term":157,"accent_statement":158,"accent_important":159,"problem":160},9,13,16,145,{"hardDependencies":162,"externals":179},[163],{"type":164,"reason":165,"contentType":166,"title":167,"link":168,"uniques":169},"hard","\n        Completing the square means \"packing\" a quadratic trinomial into either the square of a sum or a difference.\n        To understand this process, you need to know how to use these formulas!\n      ","topic","Special Products","\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F",[170,175],{"name":171,"title":172,"link":173,"schemaName":174},"squareSum","Square of a sum formula","\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=square-sum","accent_statement",{"name":176,"title":177,"link":178,"schemaName":174},"squareDiff","Square of a difference formula","\u002Farticle\u002Ffoundations\u002Fpolynomials\u002Fspecial-products\u002F?element=square-diff",[180,188],{"type":181,"items":182},"own",[183],{"type":184,"title":185,"info":186,"reason":187},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":189,"title":15,"items":190},"parent",[191],{"type":192,"title":193,"info":194,"link":195,"reason":196},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[198],{"contributorId":199,"name":200,"avatarUrl":201},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[204,287,309,319],{"type":166,"link":205,"title":206,"description":207,"decoration":208,"keyLinks":209,"stats":281},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ","content\u002F01-foundations\u002F02-equations\u002F01-elementary\u002Fdecoration.svg",[210,218,225,232,239,245,253,260,267,274],{"link":211,"schemaName":212,"title":213,"key":214,"seo":215,"description":217},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality","accent_term","Equality",{},{"title":216},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":219,"schemaName":220,"title":221,"key":222,"seo":223,"description":224},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":226,"schemaName":212,"title":227,"key":228,"seo":229,"description":231},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation","Equation",{},{"title":230},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":233,"schemaName":212,"title":234,"key":235,"seo":236,"description":238},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation-solution","Solving an Equation",{},{"title":237},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":240,"schemaName":174,"title":241,"key":242,"seo":243,"description":244},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=same-action-rule","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":246,"schemaName":247,"title":248,"key":249,"seo":250,"description":252},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=common-mistakes","list","Mistakes when solving equations",{},{"title":251},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":254,"schemaName":255,"title":256,"key":257,"seo":258,"description":259},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=why-solve-equations","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":261,"schemaName":255,"title":262,"key":263,"seo":264,"description":266},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=the-idiot-s-triangle","Triangle of Formulas",{},{"title":265},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":268,"schemaName":255,"title":269,"key":270,"seo":271,"description":273},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equations-in-life","Equations in Life",{},{"title":272},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":275,"schemaName":276,"title":277,"key":278,"seo":279,"description":280},"\u002Fpractice\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":282},{"accent_term":283,"accent_statement":284,"accent_important":285,"problem":286},3,1,4,35,{"type":8,"link":288,"title":289,"description":290,"decoration":291,"keyLinks":292,"stats":307},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F","Zero Product Property","\n    A simple and very effective way to solve equations made of factors (brackets) whose product is zero.\n    You need this method, because a huge number of different equations get reduced to exactly this form.\n  ","content\u002F01-foundations\u002F02-equations\u002F02-zero-product-property\u002Fdecoration.svg",[293,299],{"link":294,"schemaName":174,"title":289,"key":295,"seo":296,"description":298},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-method",{},{"title":297},"What is zero product property?","A convenient way to quickly solve equations written as a product of factors equal to zero.",{"link":300,"schemaName":276,"title":301,"key":302,"seo":304,"description":306},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-examples","Practicing zero product property",{"title":303},"Usage examples",{"title":305},"How to use zero product property?","Practice problems for the zero product property with detailed solutions.",{"elements":308},{"accent_statement":284,"problem":284},{"type":202,"link":310,"title":311,"description":312,"decoration":313,"stats":314},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta's formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ","content\u002F01-foundations\u002F02-equations\u002F03-quadratic\u002Fdecoration.svg",{"materials":157,"elements":315},{"accent_term":316,"accent_statement":317,"accent_important":155,"problem":318},6,11,109,{"type":166,"link":320,"title":321},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fequivalence\u002F","Equivalence of equations",{"contributorsCount":284,"sponsorsCount":323},0,{"shortBookId":5,"frontNav":325},{"type":14,"shortId":5,"title":15,"flags":326,"link":17,"children":327},{},[328,342],{"type":202,"separator":329,"shortId":330,"title":331,"flags":332,"link":333,"children":334},true,"foundations\u002Fpolynomials","Polynomials",{},"\u002Fgroup\u002Ffoundations\u002Fpolynomials\u002F",[335],{"type":166,"shortId":336,"title":167,"flags":337,"link":168,"parts":338},"foundations\u002Fpolynomials\u002Fspecial-products",{},[339,340,341],"article","summary","practice",{"type":202,"separator":329,"shortId":146,"title":148,"flags":343,"link":344,"children":345},{},"\u002Fgroup\u002Ffoundations\u002Fequations\u002F",[346,350,353,411],{"type":166,"shortId":347,"title":206,"flags":348,"link":205,"parts":349},"foundations\u002Fequations\u002Felementary",{},[339,340,341],{"type":8,"shortId":351,"title":289,"flags":352,"link":288},"foundations\