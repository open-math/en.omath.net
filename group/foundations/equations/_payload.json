,{"type":22,"value":120},"Contribution",{"type":22,"value":122},"Begin Learning!",{"type":22,"value":124},"Connections",{"type":22,"value":126},"Need to know",{"type":22,"value":128},"Depends on",{"type":22,"value":130},"Used by",{"type":27,"value":132},"(contentTitle) => `Clear and interesting explanation of the topic \"${contentTitle}\". Clear examples, important terms and statements, interesting facts, life applications.`",{"type":22,"value":134},"Externals",{"type":27,"value":136},"(contentTitle) => `Summary of the topic \"${contentTitle}\": key definitions, theorems, properties and examples of their use. All the most important things in a concise form!`",{"type":27,"value":138},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":22,"value":98},{"m":141},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":143,"mainContent":144},"group/foundations/equations/",{"fullId":145,"shortId":145,"contentRelativePath":146,"title":147,"bookTitle":15,"breadcrumbs":148,"description":151,"stats":152,"connections":157,"contributions":176,"type":181,"children":182},"foundations/equations","01-foundations/02-equations","Equations",[149],{"icon":150,"title":15,"link":17},"book-outline","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":153,"elements":154},4,{"accent_term":155,"accent_statement":153,"accent_important":155,"problem":156},6,48,{"externals":158},[159,167],{"type":160,"items":161},"own",[162],{"type":163,"title":164,"info":165,"reason":166},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":168,"title":15,"items":169},"parent",[170],{"type":171,"title":172,"info":173,"link":174,"reason":175},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[177],{"contributorId":178,"name":179,"avatarUrl":180},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[183,266,274],{"type":184,"link":185,"title":186,"description":187,"quickLinks":188,"stats":261},"topic","/article/foundations/equations/elementary/","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[189,197,204,211,218,225,233,240,247,254],{"link":190,"schemaName":191,"title":192,"quick":193,"seo":194,"description":196},"/article/foundations/equations/elementary/#equality","accent_term","Equality",{},{"title":195},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":198,"schemaName":199,"title":200,"quick":201,"seo":202,"description":203},"/article/foundations/equations/elementary/#equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":205,"schemaName":191,"title":206,"quick":207,"seo":208,"description":210},"/article/foundations/equations/elementary/#equation","Equation",{},{"title":209},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":212,"schemaName":191,"title":213,"quick":214,"seo":215,"description":217},"/article/foundations/equations/elementary/#equation-solution","Solving an Equation",{},{"title":216},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":219,"schemaName":220,"title":221,"quick":222,"seo":223,"description":224},"/article/foundations/equations/elementary/#same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":226,"schemaName":227,"title":228,"quick":229,"seo":230,"description":232},"/article/foundations/equations/elementary/#common-mistakes","list","Mistakes when solving equations",{},{"title":231},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":234,"schemaName":235,"title":236,"quick":237,"seo":238,"description":239},"/article/foundations/equations/elementary/#why-solve-equations-1","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":241,"schemaName":235,"title":242,"quick":243,"seo":244,"description":246},"/article/foundations/equations/elementary/#triangle-of-formulas","Triangle of Formulas",{},{"title":245},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":248,"schemaName":235,"title":249,"quick":250,"seo":251,"description":253},"/article/foundations/equations/elementary/#equations-in-life","Equations in Life",{},{"title":252},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":255,"schemaName":256,"title":257,"quick":258,"seo":259,"description":260},"/practice/foundations/equations/elementary/#linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":262},{"accent_term":263,"accent_statement":264,"accent_important":153,"problem":265},3,1,36,{"type":181,"link":267,"title":268,"description":269,"stats":270},"/group/foundations/equations/quadratic/","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta’s formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":271,"elements":272},2,{"accent_term":263,"accent_statement":263,"accent_important":271,"problem":273},12,{"type":184,"link":275,"title":276},"/article/foundations/equations/equivalence/","Equivalence of equations",{"contributorsCount":264,"sponsorsCount":278},0,{"shortBookId":5,"frontNav":280},{"type":14,"shortId":5,"title":15,"flags":281,"link":17,"children":282},{},[283],{"type":181,"separator":284,"shortId":145,"title":147,"flags":285,"link":286,"children":287},true,{},"/group/foundations/equations/",[288,291,306],{"type":184,"shortId":289,"title":186,"flags":290,"link":185},"foundations/equations/elementary",{},{"type":181,"separator":292,"shortId":293,"title":268,"flags":294,"link":267,"children":295},false,"foundations/equations/quadratic",{},[296,301],{"type":184,"shortId":297,"title":298,"flags":299,"link":300},"foundations/equations/quadratic/what-is-it","What is it?",{},"/article/foundations/equations/quadratic/what-is-it/",{"type":184,"shortId":302,"title":303,"flags":304,"link":305},"foundations/equations/quadratic/incomplete","With missing terms",{},"/article/foundations/equations/quadratic/incomplete/",{"type":184,"shortId":307,"title":276,"flags":308,"link":275},"foundations/equations/equivalence",{"dev":284},1770621257800]