e project.`",{"type":22,"value":122},"Breadcrumb",{"type":22,"value":124},"Begin Learning!",{"type":22,"value":126},"Connections",{"type":22,"value":128},"Updated",{"type":22,"value":130},"Own",{"type":22,"value":132},"From",{"type":22,"value":134},"Need to know",{"type":22,"value":136},"Depends on",{"type":22,"value":138},"Used by",{"type":22,"value":140},"Externals",{"m":142},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":144,"mainContent":145},"group\u002Ffoundations\u002Fequations\u002F",{"fullId":146,"shortId":146,"contentRelativePath":147,"title":148,"bookTitle":15,"breadcrumbs":149,"lastmod":152,"description":153,"stats":154,"connections":161,"contributions":180,"type":185,"children":186},"foundations\u002Fequations","01-foundations\u002F02-equations","Equations",[150],{"icon":151,"title":15,"link":17},"book-outline","2026-04-12T17:20:20+03:00","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":155,"elements":156},12,{"accent_term":157,"accent_statement":158,"accent_important":159,"problem":160},9,13,16,145,{"externals":162},[163,171],{"type":164,"items":165},"own",[166],{"type":167,"title":168,"info":169,"reason":170},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":172,"title":15,"items":173},"parent",[174],{"type":175,"title":176,"info":177,"link":178,"reason":179},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[181],{"contributorId":182,"name":183,"avatarUrl":184},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[187,272,294,304],{"type":188,"link":189,"title":190,"description":191,"decoration":192,"keyLinks":193,"stats":266},"topic","\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ","content\u002F01-foundations\u002F02-equations\u002F01-elementary\u002Fdecoration.svg",[194,202,209,216,223,230,238,245,252,259],{"link":195,"schemaName":196,"title":197,"key":198,"seo":199,"description":201},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality","accent_term","Equality",{},{"title":200},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":203,"schemaName":204,"title":205,"key":206,"seo":207,"description":208},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":210,"schemaName":196,"title":211,"key":212,"seo":213,"description":215},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation","Equation",{},{"title":214},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":217,"schemaName":196,"title":218,"key":219,"seo":220,"description":222},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation-solution","Solving an Equation",{},{"title":221},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":224,"schemaName":225,"title":226,"key":227,"seo":228,"description":229},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":231,"schemaName":232,"title":233,"key":234,"seo":235,"description":237},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=common-mistakes","list","Mistakes when solving equations",{},{"title":236},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":239,"schemaName":240,"title":241,"key":242,"seo":243,"description":244},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=why-solve-equations","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":246,"schemaName":240,"title":247,"key":248,"seo":249,"description":251},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=the-idiot-s-triangle","Triangle of Formulas",{},{"title":250},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":253,"schemaName":240,"title":254,"key":255,"seo":256,"description":258},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equations-in-life","Equations in Life",{},{"title":257},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":260,"schemaName":261,"title":262,"key":263,"seo":264,"description":265},"\u002Fpractice\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":267},{"accent_term":268,"accent_statement":269,"accent_important":270,"problem":271},3,1,4,35,{"type":8,"link":273,"title":274,"description":275,"decoration":276,"keyLinks":277,"stats":292},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F","Zero Product Property","\n    A simple and very effective way to solve equations made of factors (brackets) whose product is zero.\n    You need this method, because a huge number of different equations get reduced to exactly this form.\n  ","content\u002F01-foundations\u002F02-equations\u002F02-zero-product-property\u002Fdecoration.svg",[278,284],{"link":279,"schemaName":225,"title":274,"key":280,"seo":281,"description":283},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-method",{},{"title":282},"What is zero product property?","A convenient way to quickly solve equations written as a product of factors equal to zero.",{"link":285,"schemaName":261,"title":286,"key":287,"seo":289,"description":291},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-examples","Practicing zero product property",{"title":288},"Usage examples",{"title":290},"How to use zero product property?","Practice problems for the zero product property with detailed solutions.",{"elements":293},{"accent_statement":269,"problem":269},{"type":185,"link":295,"title":296,"description":297,"decoration":298,"stats":299},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta's formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ","content\u002F01-foundations\u002F02-equations\u002F03-quadratic\u002Fdecoration.svg"