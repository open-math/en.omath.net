n",{"type":23,"value":119},"There are no sponsors yet. You can be the first one!",{"type":23,"value":97},{"type":23,"value":122},"Key elements",{"type":23,"value":124},"Connections",{"type":23,"value":126},"Begin Learning!",{"type":23,"value":128},"This material is for learners with a high level of knowledge. It contains information that is not suitable for beginners!",{"type":23,"value":130},"Need to know",{"type":23,"value":95},{"type":23,"value":133},"Depends on",{"type":23,"value":135},"This material is in development! It may change in the future and even contain errors!",{"type":23,"value":137},"Used by",{"type":23,"value":99},{"type":23,"value":140},"Externals",{"type":23,"value":142},"This is an optional material is for learners who want to dive deeper and gain additional knowledge and context.",{"type":28,"value":144},"(contentTitle) => `Clear and interesting explanation of the topic \"${contentTitle}\". Clear examples, important terms and statements, interesting facts, life applications.`",{"m":146},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":148,"mainContent":149},"group/foundations/equations/",{"fullId":150,"shortId":150,"contentRelativePath":151,"title":152,"bookTitle":16,"breadcrumbs":153,"description":156,"stats":157,"connections":162,"contributions":178,"type":183,"children":184},"foundations/equations","01-foundations/02-equations","Equations",[154],{"icon":155,"title":16,"link":18},"book-outline","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":158,"elements":159},4,{"accent_term":160,"accent_statement":158,"accent_important":160,"problem":161},6,48,{"externals":163},[164],{"type":165,"title":16,"items":166},"parent",[167,172],{"type":168,"title":169,"info":170,"reason":171},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":173,"title":174,"info":175,"link":176,"reason":177},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[179],{"contributorId":180,"name":181,"avatarUrl":182},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[185,268,276],{"type":186,"link":187,"title":188,"description":189,"quickLinks":190,"stats":263},"topic","/article/foundations/equations/elementary/","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[191,199,206,213,220,227,235,242,249,256],{"link":192,"schemaName":193,"title":194,"quick":195,"seo":196,"description":198},"/article/foundations/equations/elementary/#equality","accent_term","Equality",{},{"title":197},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":200,"schemaName":201,"title":202,"quick":203,"seo":204,"description":205},"/article/foundations/equations/elementary/#equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":207,"schemaName":193,"title":208,"quick":209,"seo":210,"description":212},"/article/foundations/equations/elementary/#equation","Equation",{},{"title":211},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":214,"schemaName":193,"title":215,"quick":216,"seo":217,"description":219},"/article/foundations/equations/elementary/#equation-solution","Solving an Equation",{},{"title":218},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":221,"schemaName":222,"title":223,"quick":224,"seo":225,"description":226},"/article/foundations/equations/elementary/#same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":228,"schemaName":229,"title":230,"quick":231,"seo":232,"description":234},"/article/foundations/equations/elementary/#common-mistakes","list","Mistakes when solving equations",{},{"title":233},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":236,"schemaName":237,"title":238,"quick":239,"seo":240,"description":241},"/article/foundations/equations/elementary/#why-solve-equations-1","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":243,"schemaName":237,"title":244,"quick":245,"seo":246,"description":248},"/article/foundations/equations/elementary/#triangle-of-formulas","Triangle of Formulas",{},{"title":247},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":250,"schemaName":237,"title":251,"quick":252,"seo":253,"description":255},"/article/foundations/equations/elementary/#equations-in-life","Equations in Life",{},{"title":254},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":257,"schemaName":258,"title":259,"quick":260,"seo":261,"description":262},"/practice/foundations/equations/elementary/#linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":264},{"accent_term":265,"accent_statement":266,"accent_important":158,"problem":267},3,1,36,{"type":183,"link":269,"title":270,"description":271,"stats":272},"/group/foundations/equations/quadratic/","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta’s formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":273,"elements":274},2,{"accent_term":265,"accent_statement":265,"accent_important":273,"problem":275},12,{"type":186,"link":277,"title":278},"/article/foundations/equations/equivalence/","Equivalence of equations",{"contributorsCount":266,"sponsorsCount":280},0,{"shortBookId":5,"frontNav":282},{"type":15,"shortId":5,"title":16,"flags":283,"link":18,"children":284},{},[285],{"type":183,"separator":12,"shortId":150,"title":152,"flags":286,"link":287,"children":288},{},"/group/foundations/equations/",[289,292,307],{"type":186,"shortId":290,"title":188,"flags":291,"link":187},"foundations/equations/elementary",{},{"type":183,"separator":293,"shortId":294,"title":270,"flags":295,"link":269,"children":296},false,"foundations/equations/quadratic",{},[297,302],{"type":186,"shortId":298,"title":299,"flags":300,"link":301},"foundations/equations/quadratic/what-is-it","What is it?",{},"/article/foundations/equations/quadratic/what-is-it/",{"type":186,"shortId":303,"title":304,"flags":305,"link":306},"foundations/equations/quadratic/incomplete","With missing terms",{},"/article/foundations/equations/quadratic/incomplete/",{"type":186,"shortId":308,"title":278,"flags":309,"link":277},"foundations/equations/equivalence",{"dev":12},1770296904258]