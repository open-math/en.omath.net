 formula",{},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fquadratic-formula\u002F",[322,323,324],{"type":188,"shortId":358,"title":359,"flags":360,"link":361,"parts":362},"foundations\u002Fequations\u002Fquadratic\u002Ffactoring","Factoring quadratics",{},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Ffactoring\u002F",[322,323,324],{"type":8,"shortId":364,"title":365,"flags":366,"link":367},"foundations\u002Fequations\u002Fquadratic\u002Freal-world","Real Life",{"secondary":314},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fquadratic\u002Freal-world\u002F",{"type":188,"shortId":369,"title":370,"flags":371,"link":372,"parts":373},"foundations\u002Fequations\u002Fquadratic\u002Fvietas-formulas","Vieta's Formulas",{"secondary":314},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fvietas-formulas\u002F",[322,323,324],{"type":188,"shortId":375,"title":376,"flags":377,"link":378,"parts":379},"foundations\u002Fequations\u002Fquadratic\u002Fmental-solving","Mental solving",{"secondary":314,"advanced":314},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fmental-solving\u002F",[322,323],{"type":188,"shortId":381,"title":382,"flags":383,"link":384,"parts":385},"foundations\u002Fequations\u002Fquadratic\u002Fformulas","General formulas",{"secondary":314},"\u002Fsummary\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fformulas\u002F",[323,324],{"type":188,"shortId":387,"title":306,"flags":388,"link":305,"parts":389},"foundations\u002Fequations\u002Fequivalence",{"dev":314},[322],1776003694281]