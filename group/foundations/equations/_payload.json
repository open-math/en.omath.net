{"type":22,"value":122},"Begin Learning!",{"type":22,"value":124},"Connections",{"type":22,"value":126},"Own",{"type":22,"value":128},"From",{"type":22,"value":130},"Need to know",{"type":22,"value":132},"Depends on",{"type":22,"value":134},"Used by",{"type":22,"value":136},"Externals",{"m":138},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":140,"mainContent":141},"group\u002Ffoundations\u002Fequations\u002F",{"fullId":142,"shortId":142,"contentRelativePath":143,"title":144,"bookTitle":15,"breadcrumbs":145,"description":148,"stats":149,"connections":156,"contributions":175,"type":180,"children":181},"foundations\u002Fequations","01-foundations\u002F02-equations","Equations",[146],{"icon":147,"title":15,"link":17},"book-outline","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":150,"elements":151},8,{"accent_term":152,"accent_statement":153,"accent_important":154,"problem":155},9,7,10,82,{"externals":157},[158,166],{"type":159,"items":160},"own",[161],{"type":162,"title":163,"info":164,"reason":165},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":167,"title":15,"items":168},"parent",[169],{"type":170,"title":171,"info":172,"link":173,"reason":174},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[176],{"contributorId":177,"name":178,"avatarUrl":179},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[182,266,286,295],{"type":183,"link":184,"title":185,"description":186,"keyLinks":187,"stats":260},"topic","\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[188,196,203,210,217,224,232,239,246,253],{"link":189,"schemaName":190,"title":191,"key":192,"seo":193,"description":195},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality","accent_term","Equality",{},{"title":194},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":197,"schemaName":198,"title":199,"key":200,"seo":201,"description":202},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":204,"schemaName":190,"title":205,"key":206,"seo":207,"description":209},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation","Equation",{},{"title":208},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":211,"schemaName":190,"title":212,"key":213,"seo":214,"description":216},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation-solution","Solving an Equation",{},{"title":215},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":218,"schemaName":219,"title":220,"key":221,"seo":222,"description":223},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":225,"schemaName":226,"title":227,"key":228,"seo":229,"description":231},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=common-mistakes","list","Mistakes when solving equations",{},{"title":230},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":233,"schemaName":234,"title":235,"key":236,"seo":237,"description":238},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=why-solve-equations","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":240,"schemaName":234,"title":241,"key":242,"seo":243,"description":245},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=the-idiot-s-triangle","Triangle of Formulas",{},{"title":244},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":247,"schemaName":234,"title":248,"key":249,"seo":250,"description":252},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equations-in-life","Equations in Life",{},{"title":251},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":254,"schemaName":255,"title":256,"key":257,"seo":258,"description":259},"\u002Fpractice\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":261},{"accent_term":262,"accent_statement":263,"accent_important":264,"problem":265},3,1,4,35,{"type":8,"link":267,"title":268,"description":269,"keyLinks":270,"stats":284},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F","Zero Product Property","\n    A simple and very effective way to solve equations made of factors (brackets) whose product is zero.\n    You need this method, because a huge number of different equations get reduced to exactly this form.\n  ",[271,277],{"link":272,"schemaName":219,"title":268,"key":273,"seo":274,"description":276},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-method",{},{"title":275},"What is zero product property?","A convenient way to quickly solve equations written as a product of factors equal to zero.",{"link":278,"schemaName":255,"title":279,"key":280,"seo":282,"description":283},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-examples","Practicing zero product property",{"title":281},"Usage examples",{},"Practice problems for the zero product property with detailed solutions.",{"elements":285},{"accent_statement":263,"problem":263},{"type":180,"link":287,"title":288,"description":289,"stats":290},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta's formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":291,"elements":292},5,{"accent_term":293,"accent_statement":291,"accent_important":293,"problem":294},6,46,{"type":183,"link":296,"title":297},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fequivalence\u002F","Equivalence of equations",{"contributorsCount":263,"sponsorsCount":299},0,{"shortBookId":5,"frontNav":301},{"type":14,"shortId":5,"title":15,"flags":302,"link":17,"children":303},{},[304],{"type":180,"separator":305,"shortId":142,"title":144,"flags":306,"link":307,"chi