{"type":22,"value":122},"Begin Learning!",{"type":22,"value":124},"Connections",{"type":22,"value":126},"Own",{"type":22,"value":128},"From",{"type":22,"value":130},"Need to know",{"type":22,"value":132},"Depends on",{"type":22,"value":134},"Used by",{"type":22,"value":136},"Externals",{"m":138},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":140,"mainContent":141},"group\u002Ffoundations\u002Fequations\u002F",{"fullId":142,"shortId":142,"contentRelativePath":143,"title":144,"bookTitle":15,"breadcrumbs":145,"description":148,"stats":149,"connections":155,"contributions":174,"type":179,"children":180},"foundations\u002Fequations","01-foundations\u002F02-equations","Equations",[146],{"icon":147,"title":15,"link":17},"book-outline","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":150,"elements":151},9,{"accent_term":150,"accent_statement":152,"accent_important":153,"problem":154},8,14,99,{"externals":156},[157,165],{"type":158,"items":159},"own",[160],{"type":161,"title":162,"info":163,"reason":164},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":166,"title":15,"items":167},"parent",[168],{"type":169,"title":170,"info":171,"link":172,"reason":173},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[175],{"contributorId":176,"name":177,"avatarUrl":178},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[181,265,286,295],{"type":182,"link":183,"title":184,"description":185,"keyLinks":186,"stats":259},"topic","\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[187,195,202,209,216,223,231,238,245,252],{"link":188,"schemaName":189,"title":190,"key":191,"seo":192,"description":194},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality","accent_term","Equality",{},{"title":193},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":196,"schemaName":197,"title":198,"key":199,"seo":200,"description":201},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":203,"schemaName":189,"title":204,"key":205,"seo":206,"description":208},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation","Equation",{},{"title":207},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":210,"schemaName":189,"title":211,"key":212,"seo":213,"description":215},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation-solution","Solving an Equation",{},{"title":214},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":217,"schemaName":218,"title":219,"key":220,"seo":221,"description":222},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":224,"schemaName":225,"title":226,"key":227,"seo":228,"description":230},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=common-mistakes","list","Mistakes when solving equations",{},{"title":229},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":232,"schemaName":233,"title":234,"key":235,"seo":236,"description":237},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=why-solve-equations","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":239,"schemaName":233,"title":240,"key":241,"seo":242,"description":244},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=the-idiot-s-triangle","Triangle of Formulas",{},{"title":243},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":246,"schemaName":233,"title":247,"key":248,"seo":249,"description":251},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equations-in-life","Equations in Life",{},{"title":250},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":253,"schemaName":254,"title":255,"key":256,"seo":257,"description":258},"\u002Fpractice\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":260},{"accent_term":261,"accent_statement":262,"accent_important":263,"problem":264},3,1,4,35,{"type":8,"link":266,"title":267,"description":268,"keyLinks":269,"stats":284},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F","Zero Product Property","\n    A simple and very effective way to solve equations made of factors (brackets) whose product is zero.\n    You need this method, because a huge number of different equations get reduced to exactly this form.\n  ",[270,276],{"link":271,"schemaName":218,"title":267,"key":272,"seo":273,"description":275},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-method",{},{"title":274},"What is zero product property?","A convenient way to quickly solve equations written as a product of factors equal to zero.",{"link":277,"schemaName":254,"title":278,"key":279,"seo":281,"description":283},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-examples","Practicing zero product property",{"title":280},"Usage examples",{"title":282},"How to use zero product property?","Practice problems for the zero product property with detailed solutions.",{"elements":285},{"accent_statement":262,"problem":262},{"type":179,"link":287,"title":288,"description":289,"stats":290},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta's formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":291,"elements":292},6,{"accent_term":291,"accent_statement":291,"accent_important":293,"problem":294},10,63,{"type":182,"link":296,"title":297},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fequivalence\u002F","Equivalence of equations",{"contributorsCount":262,"sponsorsCount":299},0,{"shortBookId":5,"frontNav":301},{"type":14,"shortId":5,"title":15,"flags":302,"link":17,"children":303},{},[304],{"type":179,"separator":305,"shortI