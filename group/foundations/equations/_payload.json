e project.`",{"type":22,"value":122},"Breadcrumb",{"type":22,"value":124},"Begin Learning!",{"type":22,"value":126},"Connections",{"type":22,"value":128},"Updated",{"type":22,"value":130},"Own",{"type":22,"value":132},"From",{"type":22,"value":134},"Need to know",{"type":22,"value":136},"Depends on",{"type":22,"value":138},"Used by",{"type":22,"value":140},"Externals",{"m":142},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":144,"mainContent":145},"group\u002Ffoundations\u002Fequations\u002F",{"fullId":146,"shortId":146,"contentRelativePath":147,"title":148,"bookTitle":15,"breadcrumbs":149,"lastmod":152,"description":153,"stats":154,"connections":161,"contributions":180,"type":185,"children":186},"foundations\u002Fequations","01-foundations\u002F02-equations","Equations",[150],{"icon":151,"title":15,"link":17},"book-outline","2026-04-02T18:53:09+03:00","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":155,"elements":156},11,{"accent_term":157,"accent_statement":158,"accent_important":159,"problem":160},9,12,16,119,{"externals":162},[163,171],{"type":164,"items":165},"own",[166],{"type":167,"title":168,"info":169,"reason":170},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":172,"title":15,"items":173},"parent",[174],{"type":175,"title":176,"info":177,"link":178,"reason":179},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https:\u002F\u002Fmath.libretexts.org\u002F","A large amount of materials and many typical practice problems.",[181],{"contributorId":182,"name":183,"avatarUrl":184},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","group",[187,271,292,302],{"type":188,"link":189,"title":190,"description":191,"keyLinks":192,"stats":265},"topic","\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[193,201,208,215,222,229,237,244,251,258],{"link":194,"schemaName":195,"title":196,"key":197,"seo":198,"description":200},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality","accent_term","Equality",{},{"title":199},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":202,"schemaName":203,"title":204,"key":205,"seo":206,"description":207},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":209,"schemaName":195,"title":210,"key":211,"seo":212,"description":214},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation","Equation",{},{"title":213},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":216,"schemaName":195,"title":217,"key":218,"seo":219,"description":221},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equation-solution","Solving an Equation",{},{"title":220},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":223,"schemaName":224,"title":225,"key":226,"seo":227,"description":228},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":230,"schemaName":231,"title":232,"key":233,"seo":234,"description":236},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=common-mistakes","list","Mistakes when solving equations",{},{"title":235},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":238,"schemaName":239,"title":240,"key":241,"seo":242,"description":243},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=why-solve-equations","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":245,"schemaName":239,"title":246,"key":247,"seo":248,"description":250},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=the-idiot-s-triangle","Triangle of Formulas",{},{"title":249},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":252,"schemaName":239,"title":253,"key":254,"seo":255,"description":257},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=equations-in-life","Equations in Life",{},{"title":256},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":259,"schemaName":260,"title":261,"key":262,"seo":263,"description":264},"\u002Fpractice\u002Ffoundations\u002Fequations\u002Felementary\u002F?element=linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":266},{"accent_term":267,"accent_statement":268,"accent_important":269,"problem":270},3,1,4,35,{"type":8,"link":272,"title":273,"description":274,"keyLinks":275,"stats":290},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F","Zero Product Property","\n    A simple and very effective way to solve equations made of factors (brackets) whose product is zero.\n    You need this method, because a huge number of different equations get reduced to exactly this form.\n  ",[276,282],{"link":277,"schemaName":224,"title":273,"key":278,"seo":279,"description":281},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-method",{},{"title":280},"What is zero product property?","A convenient way to quickly solve equations written as a product of factors equal to zero.",{"link":283,"schemaName":260,"title":284,"key":285,"seo":287,"description":289},"\u002Fpage\u002Ffoundations\u002Fequations\u002Fzero-product-property\u002F?element=zero-product-examples","Practicing zero product property",{"title":286},"Usage examples",{"title":288},"How to use zero product property?","Practice problems for the zero product property with detailed solutions.",{"elements":291},{"accent_statement":268,"problem":268},{"type":185,"link":293,"title":294,"description":295,"stats":296},"\u002Fgroup\u002Ffoundations\u002Fequations\u002Fquadratic\u002F","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta's formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":297,"elements":298},8,{"accent_term":299,"accent_statement":300,"accent_important":158,"problem":301},6,10,83,{"type":188,"link":303,"title":304},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fequivalence\u002F","Equivalence of equations",{"contributorsCount":268,"sponsorsCount":306},0,{"shortBookId":5