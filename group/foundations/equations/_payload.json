tor",{"type":28,"value":119},"(name) => `Personal page of contributor \"${name}\" with information about their contributions to the project.`",{"type":23,"value":97},{"type":23,"value":122},"Key elements",{"type":23,"value":124},"Connections",{"type":23,"value":126},"Begin Learning!",{"type":28,"value":128},"(contentTitle) => `Clear and interesting explanation of the topic \"${contentTitle}\". Clear examples, important terms and statements, interesting facts, life applications.`",{"type":23,"value":130},"This material is for learners with a high level of knowledge. It contains information that is not suitable for beginners!",{"type":23,"value":132},"Need to know",{"type":28,"value":134},"(contentTitle) => `Summary of the topic \"${contentTitle}\": key definitions, theorems, properties and examples of their use. All the most important things in a concise form!`",{"type":23,"value":95},{"type":23,"value":137},"Depends on",{"type":28,"value":139},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":23,"value":141},"This material is in development! It may change in the future and even contain errors!",{"type":23,"value":143},"Used by",{"type":23,"value":99},{"type":23,"value":146},"Externals",{"type":23,"value":148},"This is an optional material is for learners who want to dive deeper and gain additional knowledge and context.",{"m":150},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":152,"mainContent":153},"group/foundations/equations/",{"fullId":154,"shortId":154,"contentRelativePath":155,"title":156,"bookTitle":16,"breadcrumbs":157,"description":160,"stats":161,"connections":166,"contributions":185,"type":190,"children":191},"foundations/equations","01-foundations/02-equations","Equations",[158],{"icon":159,"title":16,"link":18},"book-outline","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":162,"elements":163},4,{"accent_term":164,"accent_statement":162,"accent_important":164,"problem":165},6,48,{"externals":167},[168,176],{"type":169,"items":170},"own",[171],{"type":172,"title":173,"info":174,"reason":175},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":177,"title":16,"items":178},"parent",[179],{"type":180,"title":181,"info":182,"link":183,"reason":184},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[186],{"contributorId":187,"name":188,"avatarUrl":189},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[192,275,283],{"type":193,"link":194,"title":195,"description":196,"quickLinks":197,"stats":270},"topic","/article/foundations/equations/elementary/","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[198,206,213,220,227,234,242,249,256,263],{"link":199,"schemaName":200,"title":201,"quick":202,"seo":203,"description":205},"/article/foundations/equations/elementary/#equality","accent_term","Equality",{},{"title":204},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":207,"schemaName":208,"title":209,"quick":210,"seo":211,"description":212},"/article/foundations/equations/elementary/#equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":214,"schemaName":200,"title":215,"quick":216,"seo":217,"description":219},"/article/foundations/equations/elementary/#equation","Equation",{},{"title":218},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":221,"schemaName":200,"title":222,"quick":223,"seo":224,"description":226},"/article/foundations/equations/elementary/#equation-solution","Solving an Equation",{},{"title":225},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":228,"schemaName":229,"title":230,"quick":231,"seo":232,"description":233},"/article/foundations/equations/elementary/#same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":235,"schemaName":236,"title":237,"quick":238,"seo":239,"description":241},"/article/foundations/equations/elementary/#common-mistakes","list","Mistakes when solving equations",{},{"title":240},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":243,"schemaName":244,"title":245,"quick":246,"seo":247,"description":248},"/article/foundations/equations/elementary/#why-solve-equations-1","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":250,"schemaName":244,"title":251,"quick":252,"seo":253,"description":255},"/article/foundations/equations/elementary/#triangle-of-formulas","Triangle of Formulas",{},{"title":254},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":257,"schemaName":244,"title":258,"quick":259,"seo":260,"description":262},"/article/foundations/equations/elementary/#equations-in-life","Equations in Life",{},{"title":261},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":264,"schemaName":265,"title":266,"quick":267,"seo":268,"description":269},"/practice/foundations/equations/elementary/#linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":271},{"accent_term":272,"accent_statement":273,"accent_important":162,"problem":274},3,1,36,{"type":190,"link":276,"title":277,"description":278,"stats":279},"/group/foundations/equations/quadratic/","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta’s formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":280,"elements":281},2,{"accent_term":272,"accent_statement":272,"accent_important":280,"problem":282},12,{"type":193,"link":284,"title":285},"/article/foundations/equations/equivalence/","Equivalence of equations",{"contributorsCount":273,"sponsorsCount":287},0,{"shortBookId":5,"frontNav":289},{"type":15,"shortId":5,"title":16,"flags":290,"link":18,"children":291},{},[292],{"type":190,"separator":12,"shortId":154,"title":156,"flags":293,"link":294,"children":295},{},"/group/foundations/equations/",[296,299,314],{"type":193,"shortId":297,"title":195,"flags":298,"link":194},"foundations/equations/elementary",{},{"type":190,"separator":300,"shortId":301,"title":277,"flags":302,"link":276,"children":303},false,"foundations/equations/quadratic",{},[304,309],{"type":193,"shortId":305,"title":306,"flags":307,"link":308},"foundations/equatio