ype":22,"value":118},"Editor",{"type":27,"value":120},"(name) => `Personal page of contributor \"${name}\" with information about their contributions to the project.`",{"type":27,"value":122},"(contentTitle) => `Clear and interesting explanation of the topic \"${contentTitle}\". Clear examples, important terms and statements, interesting facts, life applications.`",{"type":22,"value":124},"Begin Learning!",{"type":27,"value":126},"(contentTitle) => `Summary of the topic \"${contentTitle}\": key definitions, theorems, properties and examples of their use. All the most important things in a concise form!`",{"type":22,"value":128},"Connections",{"type":27,"value":130},"(contentTitle) => `Various problems with hints and answers on the topic \"${contentTitle}\". Interesting conditions, hints and detailed solutions. Turn knowledge into a skill!`",{"type":22,"value":132},"Need to know",{"type":22,"value":98},{"type":22,"value":135},"Depends on",{"type":22,"value":137},"This material is for learners with a high level of knowledge. It contains information that is not suitable for beginners!",{"type":22,"value":139},"Used by",{"type":22,"value":96},{"type":22,"value":142},"Externals",{"type":22,"value":144},"This material is in development! It may change in the future and even contain errors!",{"type":22,"value":100},{"type":22,"value":147},"This is an optional material is for learners who want to dive deeper and gain additional knowledge and context.",{"m":149},"function m(number, one, few, includeNumber = true) {\n  const text = number === 1 ? one : few;\n  return includeNumber ? `${number} ${text}` : text;\n}",{"contentPath":151,"mainContent":152},"group/foundations/equations/",{"fullId":153,"shortId":153,"contentRelativePath":154,"title":155,"bookTitle":15,"breadcrumbs":156,"description":159,"stats":160,"connections":165,"contributions":184,"type":189,"children":190},"foundations/equations","01-foundations/02-equations","Equations",[157],{"icon":158,"title":15,"link":17},"book-outline","\n    An overview of equations and equation solving: elementary equations,\n    quadratic equations, and systems of equations.\n    Learn why equations are solved and how they model real-world processes.\n    Includes transformations, domain restrictions, loss of solutions,\n    and extraneous roots.\n  ",{"materials":161,"elements":162},4,{"accent_term":163,"accent_statement":161,"accent_important":163,"problem":164},6,48,{"externals":166},[167,175],{"type":168,"items":169},"own",[170],{"type":171,"title":172,"info":173,"reason":174},"physical","Algebra Word Problems","Anita Harnadek","Huge collection of word problems which lead to an equations with detailed solutions.",{"type":176,"title":15,"items":177},"parent",[178],{"type":179,"title":180,"info":181,"link":182,"reason":183},"web","LibreTexts Mathematics","An open and free online collection of mathematics educational materials.","https://math.libretexts.org/","A large amount of materials and many typical practice problems.",[185],{"contributorId":186,"name":187,"avatarUrl":188},"gwynerva","Peter Radko","/file/contributors/gwynerva/avatar.png","group",[191,274,282],{"type":192,"link":193,"title":194,"description":195,"quickLinks":196,"stats":269},"topic","/article/foundations/equations/elementary/","Elementary Equations","\n    Learn how to solve and transform elementary equations step by step.\n    Simple and visual, with clear examples and without memorizing a bunch of obscure rules.\n    This is a key foundational skill in mathematics and the exact sciences.\n  ",[197,205,212,219,226,233,241,248,255,262],{"link":198,"schemaName":199,"title":200,"quick":201,"seo":202,"description":204},"/article/foundations/equations/elementary/#equality","accent_term","Equality",{},{"title":203},"What is equality?","Two expressions with an equals sign \"=\" between them. Equality can be true (2 = 2) or false (2 = 0).",{"link":206,"schemaName":207,"title":208,"quick":209,"seo":210,"description":211},"/article/foundations/equations/elementary/#equality-false-true","diagram","True and false equality",{},{},"If identical objects stand on the sides of the = sign, then the equality is true. If different -- false.",{"link":213,"schemaName":199,"title":214,"quick":215,"seo":216,"description":218},"/article/foundations/equations/elementary/#equation","Equation",{},{"title":217},"What is an equation?","An equality in which there is one or more unknowns or variables.",{"link":220,"schemaName":199,"title":221,"quick":222,"seo":223,"description":225},"/article/foundations/equations/elementary/#equation-solution","Solving an Equation",{},{"title":224},"What does it mean to solve an equation?","\"Solutions\" or \"roots\" of an equation are numbers that, when substituted for unknowns, turn it into a true equality.\n          \"To solve an equation\" means to find all its roots and prove that there are no other roots.",{"link":227,"schemaName":228,"title":229,"quick":230,"seo":231,"description":232},"/article/foundations/equations/elementary/#same-action-rule","accent_statement","Same Action Rule",{},{},"If the same action is performed on both sides of a true equality, the resulting equality will also be true.",{"link":234,"schemaName":235,"title":236,"quick":237,"seo":238,"description":240},"/article/foundations/equations/elementary/#common-mistakes","list","Mistakes when solving equations",{},{"title":239},"Common mistakes when solving equations","A list of common mistakes that beginners make when solving equations.",{"link":242,"schemaName":243,"title":244,"quick":245,"seo":246,"description":247},"/article/foundations/equations/elementary/#why-solve-equations-1","heading","Why Solve Equations?",{},{},"A set of examples requiring the ability to solve equations to work with.",{"link":249,"schemaName":243,"title":250,"quick":251,"seo":252,"description":254},"/article/foundations/equations/elementary/#triangle-of-formulas","Triangle of Formulas",{},{"title":253},"Magic triangle of formulas","A mnemonic technique for memorizing simple formulas.",{"link":256,"schemaName":243,"title":257,"quick":258,"seo":259,"description":261},"/article/foundations/equations/elementary/#equations-in-life","Equations in Life",{},{"title":260},"Where are equations used in life?","A selection of problems and situations from real life that can be solved if translated into equations.",{"link":263,"schemaName":264,"title":265,"quick":266,"seo":267,"description":268},"/practice/foundations/equations/elementary/#linear-root","problems","Linear equations formula",{},{},"Formula by which you can very quickly find the root of any equation of the form Ax + B = 0.",{"elements":270},{"accent_term":271,"accent_statement":272,"accent_important":161,"problem":273},3,1,36,{"type":189,"link":275,"title":276,"description":277,"stats":278},"/group/foundations/equations/quadratic/","Quadratic Equations","\n    A comprehensive overview of quadratic equations, including quadratic trinomials, completing the square,\n    the discriminant, Vieta’s formulas, factoring, real-life applications, and even methods for solving them mentally.\n  ",{"materials":279,"elements":280},2,{"accent_term":271,"accent_statement":271,"accent_important":279,"problem":281},12,{"type":192,"link":283,"title":284},"/article/foundations/equations/equivalence/","Equivalence of equations",{"contributorsCount":272,"sponsorsCount":286},0,{"shortBookId":5,"frontNav":288},{"type":14,"shortId":5,"title":15,"flags":289,"link":17,"children":290},{},[291],{"type":189,"separator":292,"shortId":153,"title":155,"flags":293,"link":294,"children":295},true,{},"/group/foundations/equations/",[296,299,314],{"type":192,"shortId":297,"title":194,"flags":298,"link":193},"foundations/equations/elementary",{},{"type":189,"separator":300,"shortId":301,"title":276,"flags":302,"link":275,"children":303},false,"foundations/equations/quadratic",{},[304,309],{"type":192,"shortId":305,"title":306,"flags":307,"link":308},"foundations/equations/quad