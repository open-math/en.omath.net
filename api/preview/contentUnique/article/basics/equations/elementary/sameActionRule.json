xt","data":"But it turned out that this is no joke. Previously, using this test, it was quite "},{"__JSPROSE_element":true,"schemaName":"referenceInliner","data":{"label":"realistic to find out"},"storageKey":"<link:global>/basics/equations/elementary/article/$communistTest","id":"referenceInliner-kBM7Zn6N5Nrj"},{"__JSPROSE_element":true,"schemaName":"text","data":" if a person is a communist."}],"id":"paragraph-tcpDgKZNm5VS"},{"__JSPROSE_element":true,"schemaName":"details","data":{"title":"Are you a communist?!"},"children":[{"__JSPROSE_element":true,"schemaName":"paragraph","children":[{"__JSPROSE_element":true,"schemaName":"text","data":"The phrase \"duck test\" was "},{"__JSPROSE_element":true,"schemaName":"referenceInliner","data":{"label":"first uttered"},"storageKey":"<link:direct>/https://en.wikipedia.org/wiki/Duck_test","id":"referenceInliner-IHex5oAz6bNE"},{"__JSPROSE_element":true,"schemaName":"text","data":" by Richard Patterson, the US ambassador to Guatemala, in 1950. In his opinion, hidden communists should be calculated precisely by indirect signs, and not by direct statements:"}],"id":"paragraph-NEGNZVcxkw6C"},{"__JSPROSE_element":true,"schemaName":"paragraph","data":{"center":true,"serif":true},"children":[{"__JSPROSE_element":true,"schemaName":"emphasis","data":{"type":"italic"},"children":[{"__JSPROSE_element":true,"schemaName":"text","data":"\"You often cannot prove judicially that a certain person is a communist. For such cases, I recommend a practical method — the duck test\""}],"id":"emphasis-JtvvLm2mbSXW"}],"id":"paragraph-x6vIsFtjqJUq"},{"__JSPROSE_element":true,"schemaName":"paragraph","children":[{"__JSPROSE_element":true,"schemaName":"text","data":"In this speech, he hinted at Guatemalan President Jacobo Arbenz Guzman, who was later overthrown in a coup involving the CIA."}],"id":"paragraph-OCAr4Wxtx6LD"}],"id":"communist-test","uniqueName":"communistTest"},{"__JSPROSE_element":true,"schemaName":"paragraph","children":[{"__JSPROSE_eleme