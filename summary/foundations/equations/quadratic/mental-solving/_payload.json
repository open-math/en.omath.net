},"gwynerva","Peter Radko","\u002Ffile\u002Fcontributors\u002Fgwynerva\u002Favatar.png","Idea and main content.","summary",[257,255],"article",{"__TSPROSE_proseElement":175,"schema":259,"children":263},{"name":260,"type":261,"linkable":262,"__TSPROSE_schema":175},"mix","block",false,[264,281,284,304],{"__TSPROSE_proseElement":175,"schema":265,"children":267,"id":280},{"name":266,"type":261,"linkable":175,"__TSPROSE_schema":175},"diagram",[268,273],{"__TSPROSE_proseElement":175,"schema":269,"data":272},{"name":270,"type":271,"linkable":262,"__TSPROSE_schema":175},"text","inliner","\n        flowchart TD\n          methods[\"**Mental solving**\u003Cbr \u002F>Incomplete quadratics\"]\n\n          methods --> methodB0[\"\n            **B equals 0**\n            $$ \\begin{aligned} Ax^2 + C = 0 \\\\ 5x^2 - 20 = 0 \\end{aligned} $$\n          \"]\n          methodB0 --> rootsB0[\"$$x_{1,2} = \\pm\\sqrt{-\\frac{C}{A}}$$\"]\n\n          methods --> methodC0[\"\n            **C equals 0**\n            $$ \\begin{aligned} Ax^2 + Bx = 0 \\\\ 3x^2 + 12x = 0 \\end{aligned} $$\n          \"]\n          methodC0 --> root1C0[\"$$x_1 = 0$$\"]\n          methodC0 -->|1st Vieta formula| root2C0[\"$$x_2 = -\\frac{B}{A}$$\"]\n\n          methods --> methodBC0[\"\n            **B and C equal 0**\n            $$ \\begin{aligned} Ax^2 = 0 \\\\ 4x^2 = 0 \\end{aligned} $$\n          \"]\n          methodBC0 --> rootBC0[\"$$x_1 = x_2 = 0$$\"]\n\n        class methodB0,methodC0,methodBC0 fill\n      ",{"__TSPROSE_proseElement":175,"schema":274,"children":276},{"name":275,"type":271,"linkable":262,"__TSPROSE_schema":175},"caption",[277],{"__TSPROSE_proseElement":175,"schema":278,"data":279},{"name":270,"type":271,"linkable":262,"__TSPROSE_schema":175},"Ways to solve incomplete quadratics mentally","incomplete-equations",{"__TSPROSE_proseElement":175,"schema":282},{"name":283,"type":261,"linkable":262,"__TSPROSE_schema":175},"hr",{"__TSPROSE_proseElement":175,"schema":285,"children":286,"id":303},{"name":266,"type":261,"linkable":175,"__TSPROSE_schema":175},[287,290],{"__TSPROSE_proseElement":175,"schema":288,"data":289},{"name":270,"type":271,"linkable":262,"__TSPROSE_schema":175},"\n        flowchart LR\n          methods[\"**Mental solving**\u003Cbr \u002F>$$ Ax^2 + Bx + C = 0 $$\"]\n\n          methods --> methodZeroSum[\"\n            **1. Zero sum**\n            $$ \\begin{aligned} A \\pm B + C = 0 \\\\ 2x^2 + 3x - 5 = 0 \\end{aligned} $$\n          \"]\n          methodZeroSum --> methodZeroSumRoot1[\"$$ x_1 = \\pm 1 $$\"]\n          methodZeroSum -->|2nd Vieta formula| methodZeroSumRoot2[\"$$ x_2 = \\pm \\frac{C}{A} $$\"]\n\n          methods --> methodSquare[\"\n            **2. Perfect square**\n            $$ \\begin{aligned} (Kx)^2 \\pm 2 \\cdot Kx \\cdot T + (T)^2 \\\\ 4x^2 + 12x + 9 = 0 \\end{aligned} $$\n          \"]\n          methodSquare -->|$A$ lives downstairs\u003Cbr \u002F>$K$ came from $A$, so it does too| methodSquareRoot[\"$$ x_1 = x_2 = \\mp \\frac{T}{K} $$\"]\n\n          methods --> methodFactoring[\"\n            **3. Factoring**\n            $$ \\begin{aligned} x^2 + (t + k)x + tk = 0 \\\\ x^2 + 8x + 15 = 0 \\end{aligned} $$\n          \"]\n          methodFactoring -->|Minus in front of $t$| methodFactoringRoot1[\"$$ x_1 = -t $$\"]\n          methodFactoring -->|Minus in front of $k$| methodFactoringRoot2[\"$$ x_2 = -k $$\"]\n\n          methods --> methodAtoC[\"\n            **4. Transfer A to C**\n            $$ \\begin{aligned} x^2 + Bx + AC = 0 \\\\ 3x^2 - 17x - 6 = 0 \\end{aligned} $$\n          \"]\n          methodAtoC -->|$A$ lives downstairs\u003Cbr \u002F>So divide the roots by $A$| methodAtoCRoots[\"$$ x_{1,2} = \\frac{x'_{1,2}}{A} $$\"]\n\n          class methodZeroSum,methodSquare,methodFactoring,methodAtoC fill\n      ",{"__TSPROSE_proseElement":175,"schema":291,"children":292},{"name":275,"type":271,"linkable":262,"__TSPROSE_schema":175},[293,296],{"__TSPROSE_proseElement":175,"schema":294,"data":295},{"name":270,"type":271,"linkable":262,"__TSPROSE_schema":175},"Ways to solve quadratic equations mentally",{"__TSPROSE_proseElement":175,"schema":297,"children":299},{"name":298,"type":271,"linkable":262,"__TSPROSE_schema":175},"captionSecondary",[300],{"__TSPROSE_proseElement":175,"schema":301,"data":302},{"name":270,"type":271,"linkable":262,"__TSPROSE_schema":175},"Ordered from easiest to hardest","method-chart",{"__TSPROSE_proseElement":175,"schema":305,"data":307,"storageKey":313,"children":314,"id":345},{"name":306,"type":261,"linkable":175,"__TSPROSE_schema":175},"problem",{"info":308,"scriptUniques":312},{"title":309,"level":310,"attributes":311},"Mental solving of quadratic equations","medium",[],{},"problemScript:content\u002F01-foundations\u002F02-equations\u002F03-quadratic\u002F8-mental-solving\u002Fscripts\u002Fmixed",[315,326,333],{"__TSPROSE_proseElement":175,"schema":316,"children":318},{"name":317,"type":261,"linkable":262,"__TSPROSE_schema":175},"problemDescription",[319],{"__TSPROSE_proseElement":175,"schema":320,"data":322,"storageKey":324,"id":325},{"name":321,"type":261,"linkable":175,"__TSPROSE_schema":175},"blockMath",{"katex":323,"freeze":262},"2x^2 - x - 5 = 0","$$ 2x^2 - x - 5 = 0 $$","blockMath-znOe1tOSl",{"__TSPROSE_proseElement":175,"schema":327,"data":329},{"name":328,"type":261,"linkable":262,"__TSPROSE_schema":175},"problemCheck",{"label":330,"serializedValidator":331},"Solvable mentally?",{"type":332,"answer":262},"boolean",{"__TSPROSE_proseElement":175,"schema":334,"children":336},{"name":335,"type":261,"linkable":262,"__TSPROSE_schema":175},"problemAnswer",[337],{"__TSPROSE_proseElement":175,"schema":338,"children":340,"id":344},{"name":339,"type":261,"linkable":175,"__TSPROSE_schema":175},"paragraph",[341],{"__TSPROSE_proseElement":175,"schema":342,"data":343},{"name":270,"type":271,"linkable":262,"__TSPROSE_schema":175},"None of the mental methods works for this equation.","paragraph-KeLvYmdNU","mental-solving-of-quadratic-equations",{"problemScript:content\u002F01-foundations\u002F02-equations\u002F03-quadratic\u002F8-mental-solving\u002Fscripts\u002Fmixed":347,"$$ 2x^2 - x - 5 = 0 $$":349},{"resolvedScriptSrc":348},"\u002Fapi\u002FproblemScript\u002Fcontent\u002F01-foundations\u002F02-equations\u002F03-quadratic\u002F8-mental-solving\u002Fscripts\u002Fmixed.js",null,[351,358,363,370,377,382,388],{"link":352,"schemaName":266,"title":353,"key":354,"seo":355,"description":357},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fmental-solving\u002F?element=methods-incomplete","Incomplete equations",{},{"title":356},"Mental solving of incomplete quadratics","Every incomplete quadratic equation can be solved mentally by one of three formulas.\n          There is nothing to guess.\n          The solution is straightforward.",{"link":231,"schemaName":218,"title":230,"key":359,"seo":360,"description":362},{},{"title":361},"Mental solving of quadratic equations from the sum of coefficients","A zero sum of coefficients lets you get the roots instantly.\n          This is the simplest and most useful way to solve quadratic equations mentally.",{"link":364,"schemaName":218,"title":365,"key":366,"seo":367,"description":369},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fmental-solving\u002F?element=method-square","Perfect square",{},{"title":368},"Mental solving of quadratic equations through a perfect square","Sometimes a quadratic equation can be packed entirely into a square of a sum or a difference.\n          In that case it has one root, and that root is easy to get.",{"link":371,"schemaName":218,"title":372,"key":373,"seo":374,"description":376},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fmental-solving\u002F?element=method-factoring","Factoring",{},{"title":375},"Mental solving of quadratic equations by factoring","If the quadratic equation is monic (A = 1), you can try factoring it mentally.\n          Find t and k so that t + k = B and tk = C. Then the roots are -t and -k.",{"link":227,"schemaName":218,"title":226,"key":378,"seo":379,"description":381},{},{"title":380},"How do you get a monic quadratic equation?","A simple way to turn a quadratic equation into a monic one that may be solvable mentally.\n          To do it, transfer coefficient A to C.",{"link":383,"schemaName":266,"title":384,"key":385,"seo":386,"description":387},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fmental-solving\u002F?element=methods-all","Method chart",{},{"title":295},"A convenient chart listing all fast ways to solve quadratic equations mentally.\n          Includes hints about the roots.",{"link":389,"schemaName":306,"title":390,"key":391,"seo":392,"description":394},"\u002Farticle\u002Ffoundations\u002Fequations\u002Fquadratic\u002Fmental-solving\u002F?element=methods-all-practice","All methods mixed",{},{"title":393},"Practice problems on mentally solving quadratic equations","Infinitely generated practice on all methods of mental solving of quadratic equations:\n          zero sum, perfect square, factoring, and transferring A to C.",[396,399,400],{"type":397,"schemaName":266,"title":398,"elementId":280},"element","Ways to solve incomplete equations mentally",{"type":397,"schemaName":266,"title":295,"elementId":303},{"type":397,"schemaName":306,"title":309,"elementId":345},{"contributorsCount":179,"sponsorsCount":402},0,{"shortBookId":5,"frontNav":404},{"type":14,"shortId":5,"title":15,"flags":405,"link":17,"children":406},{},[407],{"type":408,"separator":175,"shortId":409,"title":166,"flags":410,"link":167,"children":411},"group","foundations\u002Fequations",{},[412,419,422,472],{"type":187,"shortId":413,"title":414,"flags":415,"link":416,"parts":417},"foundations\u002Fequations\u002Felementary","Elementary Equations",{},"\u002Farticle\u002Ffoundations\u002Fequations\u002Felementary\u002F",[257,255,418],"practice",{"type":8,"shortId":420,"title":184,"flags":421,"link":185},"foundations\u002Fequ